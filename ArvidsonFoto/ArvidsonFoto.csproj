<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Common">
    <UserSecretsId>aspnet-ArvidsonFoto-12D5C8B6-497A-402B-A341-5E18649479B4</UserSecretsId>
    <!-- <GenerateDocumentationFile>true</GenerateDocumentationFile> -->
    <CompileScss>true</CompileScss>
  </PropertyGroup>

  <PropertyGroup Label="DeterministicBuild">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/__/</PathMap>
  </PropertyGroup>

  <ItemGroup Label="PackageReferences">
    <PackageReference Include="Azure.Identity" /> <!-- Osäker vart denna används... -->
    <PackageReference Include="MailKit" /> <!-- Används för att skicka mail från kontakt-/köp av bilder sidan -->
    <PackageReference Include="MimeKit" /> <!-- Används för kryptering av skicka mail -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" /> <!-- Osäker vart denna används... -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" /> <!-- Används för inloggning på sidan -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" /> <!-- Används som utökning av inloggningens UI  -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" /> <!-- Används för Databas-anrop -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" /> <!-- In-memory databas för utveckling -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"> <!-- Osäker om denna verkligen används, men annars för DB-anrop -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" /> <!-- Används för loggning -->
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" /> <!-- Används för loggning till fil -->
    <PackageReference Include="Serilog.Sinks.Console" /> <!-- Används för loggning till konsol i Development -->
    <PackageReference Include="LigerShark.WebOptimizer.Core" /> <!-- För CSS/JS minifiering och bundling -->
    <PackageReference Include="LigerShark.WebOptimizer.Sass" /> <!-- För SCSS kompilering -->
    <PackageReference Include="JavaScriptEngineSwitcher.V8" /> <!-- JavaScript engine för SCSS kompilering -->
    <PackageReference Include="JavaScriptEngineSwitcher.Extensions.MsDependencyInjection" /> <!-- DI för JS engine -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" /> <!-- OpenAPI support -->
    <PackageReference Include="Scalar.AspNetCore" /> <!-- Scalar UI för OpenAPI dokumentation -->
  </ItemGroup>

  <ItemGroup Label="Folders">
    <Folder Include="logs\" /> <!-- Mapp dit jag styrt att Serilog, ska lägga sina .log-filer -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArvidsonFoto.ServiceDefaults\ArvidsonFoto.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>