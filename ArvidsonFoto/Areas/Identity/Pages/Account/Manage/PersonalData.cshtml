@page
@using ArvidsonFoto.Views.Shared
@model PersonalDataModel
@{
    ViewData["Title"] = L["Identity.Manage.PersonalData.PersonalData"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.HanteraKontot;
}

<h4>@ViewData["Title"]</h4>

<div class="row">
    <div class="col-md-6">
        <p>@L["Identity.Manage.PersonalData.YourAccountContainsPersonalDataThatThatData"]</p>
        <p>
            <strong>@L["Identity.Manage.DeletePersonalData.DeletingThisDataWillPermanentlyRemoveBeRecovered"]</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group">
            <button class="btn btn-primary" type="submit">@L["Identity.Manage.PersonalData.Download"]</button>
        </form>
        @*<p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-secondary">Delete</a>
        </p>*@
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
