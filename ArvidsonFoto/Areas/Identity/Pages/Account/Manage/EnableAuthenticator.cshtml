@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = L["Text.dfb94da089ff"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4>@ViewData["Title"]</h4>
<div>
    <p>@L["Text.20e868ce7fb6"]</p>
    <ol class="list">
        <li>
            <p>
                @L["Text.123b9c0af185"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> @L["Text.6201111b83a0"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> @L["Manage.OrGoogleAuthenticator"]
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> @L["Text.6201111b83a0"]
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>@L["Text.735d26373251"] <kbd>@Model.SharedKey</kbd> @L["Text.11a41e7406a7"]</p>
            <div class="alert alert-info">@L["Text.4836bc293b83"] <a href="https://go.microsoft.com/fwlink/?Linkid=852423">@L["Text.5f2d187dbbf8"]</a>.</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Html.Raw(@Model.AuthenticatorUri)"></div>
        </li>
        <li>
            <p>
                @L["Manage.AuthenticatorCodeInstructions"]
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-group">
                            <label asp-for="Input.Code" class="control-label">@L["Text.4c71415f2039"]</label>
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">@L["Text.eea2745e2867"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
