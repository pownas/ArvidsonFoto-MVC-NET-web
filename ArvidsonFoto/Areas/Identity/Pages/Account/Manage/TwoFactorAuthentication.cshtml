@page
@using ArvidsonFoto.Views.Shared
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = L["Identity.Manage.TwoFactorAuthentication.TwoFactorAuthentication2FA"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.HanteraKontot;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4>@ViewData["Title"]</h4>
@if (Model.Is2faEnabled)
{
    if (Model.RecoveryCodesLeft == 0)
    {
        <div class="alert alert-danger">
            <strong>@L["Identity.Manage.TwoFactorAuthentication.YouHaveNoRecoveryCodesLeft"]</strong>
            <p>@L["Identity.Manage.TwoFactorAuthentication.YouMust"] <a asp-page="./GenerateRecoveryCodes">@L["Identity.Manage.TwoFactorAuthentication.GenerateANewSetOfRecoveryCodes"]</a> @L["Identity.Manage.TwoFactorAuthentication.BeforeYouCanLogInWithRecoveryCode"]</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft == 1)
    {
        <div class="alert alert-danger">
            <strong>@L["Identity.Manage.TwoFactorAuthentication.YouHave1RecoveryCodeLeft"]</strong>
            <p>@L["Identity.Manage.TwoFactorAuthentication.YouCan"] <a asp-page="./GenerateRecoveryCodes">@L["Identity.Manage.TwoFactorAuthentication.GenerateANewSetOfRecoveryCodes"]</a>.</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft <= 3)
    {
        <div class="alert alert-warning">
            <strong>@L["Manage.RecoveryCodesLeft", Model.RecoveryCodesLeft]</strong>
            <p>@L["Identity.Manage.TwoFactorAuthentication.YouShould"] <a asp-page="./GenerateRecoveryCodes">@L["Identity.Manage.TwoFactorAuthentication.GenerateANewSetOfRecoveryCodes"]</a>.</p>
        </div>
    }

    if (Model.IsMachineRemembered)
    {
        <form method="post" style="display: inline-block">
            <button type="submit" class="btn btn-primary">@L["Identity.Manage.TwoFactorAuthentication.ForgetThisBrowser"]</button>
        </form>
    }
    <a asp-page="./Disable2fa" class="btn btn-primary">@L["Identity.Manage.Disable2fa.Disable2FA"]</a>
    <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">@L["Identity.Manage.TwoFactorAuthentication.ResetRecoveryCodes"]</a>
}

<h5>@L["Identity.Manage.TwoFactorAuthentication.AuthenticatorApp"]</h5>
@if (!Model.HasAuthenticator)
{
    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Identity.Manage.TwoFactorAuthentication.AddAuthenticatorApp"]</a>
}
else
{
    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Identity.Manage.TwoFactorAuthentication.SetupAuthenticatorApp"]</a>
    <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">@L["Identity.Manage.TwoFactorAuthentication.ResetAuthenticatorApp"]</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}