@page
@using ArvidsonFoto.Views.Shared
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = L["Text.e77ff2abe078"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.HanteraKontot;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4>@ViewData["Title"]</h4>
@if (Model.Is2faEnabled)
{
    if (Model.RecoveryCodesLeft == 0)
    {
        <div class="alert alert-danger">
            <strong>@L["Text.40d779c41a35"]</strong>
            <p>@L["Text.08801a334d95"] <a asp-page="./GenerateRecoveryCodes">@L["Text.f47cd8cc79df"]</a> @L["Text.c3c0d95f4b15"]</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft == 1)
    {
        <div class="alert alert-danger">
            <strong>@L["Text.2e7fdf251c09"]</strong>
            <p>@L["Text.bd5c4d03f407"] <a asp-page="./GenerateRecoveryCodes">@L["Text.f47cd8cc79df"]</a>.</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft <= 3)
    {
        <div class="alert alert-warning">
            <strong>@L["Manage.RecoveryCodesLeft", Model.RecoveryCodesLeft]</strong>
            <p>@L["Text.2cf7a09bdf2c"] <a asp-page="./GenerateRecoveryCodes">@L["Text.f47cd8cc79df"]</a>.</p>
        </div>
    }

    if (Model.IsMachineRemembered)
    {
        <form method="post" style="display: inline-block">
            <button type="submit" class="btn btn-primary">@L["Text.94e93346de45"]</button>
        </form>
    }
    <a asp-page="./Disable2fa" class="btn btn-primary">@L["Text.1c3193f3a0b8"]</a>
    <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">@L["Text.0a5a4177daaa"]</a>
}

<h5>@L["Text.09a12ace273f"]</h5>
@if (!Model.HasAuthenticator)
{
    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Text.abf30f9a3e05"]</a>
}
else
{
    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">@L["Text.730f01f27029"]</a>
    <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">@L["Text.508b214dd7c5"]</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}