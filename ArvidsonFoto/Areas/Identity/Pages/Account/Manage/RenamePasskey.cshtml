@page "{id}"
@using ArvidsonFoto.Views.Shared
@model RenamePasskeyModel
@{
    ViewData["Title"] = L["Text.e6f3d0d49a80"];
    ViewData["ActivePage"] = ManageNavPages.Passkeys;
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.HanteraKontot;
}

@if (Model.Passkey?.Name is { } name)
{
    <h4>@L["Manage.RenameExistingPasskey", name]</h4>
}
else
{
    <h4>@L["Text.d4c87d705151"]</h4>
}
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Name"></label>
                <input asp-for="Input.Name" class="form-control" placeholder="@L["Text.3dbfdcbc84fd"]" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">@L["Text.2ac5c9c2bb0c"]</button>
                <a asp-page="./Passkeys" class="btn btn-secondary ms-2">@L["Text.fc965dadc98c"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
