@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = L["Identity.ResetPasswordConfirmation.ResetPasswordConfirmation"];
}

<h2>@ViewData["Title"]</h2>
<p>
    @L["Identity.ResetPasswordConfirmation.YourPasswordHasBeenResetPlease"] <a asp-page="./Login">@L["Identity.ResetPasswordConfirmation.ClickHereToLogIn"]</a>.
</p>
