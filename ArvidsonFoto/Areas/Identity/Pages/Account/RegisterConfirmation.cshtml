@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = L["Text.cef044498a9c"];
}

<h2>@ViewData["Title"]</h2>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    @L["Text.b87dd06a67be"] <a href="https://aka.ms/aspaccountconf">@L["Text.21330d0902f3"]</a> @L["Register.ConfigureEmailSender"]
    @L["Register.NormallyEmailed"] <a id="confirm-link" href="@Model.EmailConfirmationUrl">@L["Text.8bd2f5db58af"]</a>
</p>
    }
    else
    {
<p>
        @L["Text.a84ce6682bca"]
</p>
    }
}
