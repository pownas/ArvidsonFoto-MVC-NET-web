@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = L["Identity.RegisterConfirmation.RegisterConfirmation"];
}

<h2>@ViewData["Title"]</h2>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    @L["Identity.RegisterConfirmation.ThisAppDoesNotCurrentlyHaveRegisteredSee"] <a href="https://aka.ms/aspaccountconf">@L["Identity.RegisterConfirmation.TheseDocs"]</a> @L["Register.ConfigureEmailSender"]
    @L["Register.NormallyEmailed"] <a id="confirm-link" href="@Model.EmailConfirmationUrl">@L["Identity.RegisterConfirmation.ClickHereToConfirmYourAccount"]</a>
</p>
    }
    else
    {
<p>
        @L["Identity.RegisterConfirmation.PleaseCheckYourEmailToConfirmYourAccount"]
</p>
    }
}
