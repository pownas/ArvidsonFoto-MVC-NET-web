@page
@model ErrorModel
@{
    ViewData["Title"] = L["Identity.Error.Error"];
}

<h2 class="text-danger">@L["Identity.Error.Error2"]</h2>
<h2 class="text-danger">@L["Identity.Error.AnErrorOccurredWhileProcessingYourRequest"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Identity.Error.RequestID"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["Identity.Error.DevelopmentMode"]</h3>
<p>
    @L["Identity.Error.SwappingTo"] <strong>@L["Identity.Error.Development"]</strong> @L["Identity.Error.EnvironmentWillDisplayMoreDetailedInformationThatOccurred"]
</p>
<p>
    <strong>@L["Identity.Error.DevelopmentEnvironmentShouldNotBeEnabledDeployedApplications"]</strong>@L["Error.DevelopmentDetails"] <strong>@L["Identity.Error.ASPNETCOREENVIRONMENT"]</strong> @L["Error.EnvironmentVariable"] <strong>@L["Identity.Error.Development"]</strong>@L["Error.Restart"]
</p>
