@inject IStringLocalizer<InfoResource> I
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core.Extensions
@using ArvidsonFoto.Core
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@model ContactFormInputDto

@section MetaData {
    <meta name="robots" content="noimageindex" />
    <meta name="description" content="@I["Buy.Metadata.Description"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Kop_av_bilder"))" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@T["Navigation.BuyPhotos"] - Torbjörn Arvidson Foto">
    <meta name="twitter:description" content="@I["Buy.Metadata.Description"]">
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg">

    <!-- Open Graph for social media sharing -->
    <meta property="og:title" content="@T["Navigation.BuyPhotos"] - Torbjörn Arvidson Foto" />
    <meta property="og:description" content="@I["Buy.Metadata.Description"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Kop_av_bilder"))" />
}

<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="@ArvidsonFoto.Core.Extensions.LocalizedRoutes.Page("/Info")">Info</a></li>
        <li class="breadcrumb-item active" aria-current="page">@T["Navigation.BuyPhotos"]<i class="bi bi-cart3 mx-1"></i></li>
    </ol>
</nav>

<h2><i class="bi bi-cart3"></i> @ViewData["Title"]</h2>

<div id="page-content" class="brodtext">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100 d-flex flex-column">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-info-circle"></i> @I["Buy.Header.Information"]</h3>
                </div>
                <div class="card-body flex-grow-1">
                    <p><strong>@I["Buy.Content.Question"]</strong></p>
                    <p>@I["Buy.Content.Instructions"]</p>
                    <p>@I["Buy.Content.SeeContact"] <a href="@LocalizedRoutes.Page("/Info/Kontakta")">@T["Navigation.Contact"]</a>.</p>
                    
                    <div class="mt-4">
                        <h4><i class="bi bi-check-circle"></i> @I["Buy.Header.Services"]</h4>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-image text-primary"></i> @I["Buy.List.Print"]</li>
                            <li><i class="bi bi-file-earmark-image text-primary"></i> @I["Buy.List.Digital"]</li>
                            <li><i class="bi bi-newspaper text-primary"></i> @I["Buy.List.Editorial"]</li>
                            <li><i class="bi bi-megaphone text-primary"></i> @I["Buy.List.Commercial"]</li>
                        </ul>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">
                        <i class="bi bi-clock"></i> @I["Contact.Content.ReplyTime"]
                    </small>
                </div>
            </div>
        </div>
        
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-envelope-paper"></i> @I["Contact.Form.Header"]</h3>
                </div>
                <div class="card-body">
                    <partial name="_ContactForm" model="Model" />
                </div>
            </div>
        </div>
    </div>
    
    @*<!--<p>Ett urval av arkivets bilder samt många flera finns på bildbyrerna:</p>
        <p><img src="images/logo_Matton.jpg" height="64" /> <a href="http://www.matton.se/bilder/sok/torbjo3rn+arvidson.html" target="_blank">Matton Collection</a></p>
        <p><img src="images/logo_Nordic.jpg" height="64" /> <a href="http://nordicphotos.com/Torbj%C3%B6rn%20Arvidson-3204" target="_blank">Nordic Photos</a></p>
        <p><img src="images/logo_IBL.jpg" height="64" /> <a href="http://bildarkiv.iblbildbyra.se/fotoweb/Grid.fwx?archiveId=5000&search=(IPTC080%20contains(Torbj%C3%B6rn%20Arvidson%20%2F%20IBL%20Bildbyr%C3%A5))" target="_blank">IBL Bildbyrå</a></p>-->*@
</div>

@*<!-- Kräver att man har denna för validerings-scriptet ska läsas in... -->*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ContactForm.js"></script>
}