@inject IStringLocalizer<InfoResource> I
@using ArvidsonFoto.Core.Extensions
@using ArvidsonFoto.Core
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@section MetaData {
    <meta name="robots" content="noimageindex" />
    <meta name="description" content="@I["Copyright.Metadata.Description"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Copyright"))" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Copyright - Torbjörn Arvidson Foto">
    <meta name="twitter:description" content="@I["Copyright.Metadata.Description"]">
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg">

    <!-- Open Graph for social media sharing -->
    <meta property="og:title" content="Copyright - Torbjörn Arvidson Foto" />
    <meta property="og:description" content="@I["Copyright.Metadata.Description"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Copyright"))" />
}

<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="@ArvidsonFoto.Core.Extensions.LocalizedRoutes.Page("/Info")">Info</a></li>
        <li class="breadcrumb-item active" aria-current="page">Copyright &copy;</li>
    </ol>
</nav>

<h2>Copyright &copy; 2003–@DateTime.Now.Year Torbjörn Arvidson</h2>

<div id="page-content" class="brodtext">
    <p>@I["Copyright.Content.RightsReserved"]</p>
    <p>&copy; @I["Copyright.Content.Notice"]</p>
</div>