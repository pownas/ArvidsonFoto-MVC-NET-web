@inject IStringLocalizer<InfoResource> I
@inject IStringLocalizer<HomeResource> H
@using ArvidsonFoto.Core
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core.Extensions
@using ArvidsonFoto.Core.Interfaces
@using Microsoft.Extensions.Localization
@inject IApiCategoryService CategoryService
@inject IStringLocalizer<SharedResource> T
@{
    var categories = CategoryService.GetAll();
    ViewData["Title"] = T["Navigation.Sitemap"].Value;
    var byParent = categories.ToLookup(c => c.ParentCategoryId ?? 0);
}
@section MetaData {
    <meta name="robots" content="noimageindex" />
    <meta name="description" content="@H["Home.SitemapDetail"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Sidkarta"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@T["Navigation.Sitemap"] - Torbjörn Arvidson Foto" />
    <meta name="twitter:description" content="@H["Home.SitemapDetail"]" />
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:title" content="@T["Navigation.Sitemap"] - Torbjörn Arvidson Foto" />
    <meta property="og:description" content="@H["Home.SitemapDetail"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Sidkarta"))" />
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="@LocalizedRoutes.Page("/Info")">Info</a></li>
        <li class="breadcrumb-item active" aria-current="page">@T["Navigation.Sitemap"]</li>
    </ol>
</nav>
<h2><i class="bi bi-diagram-3"></i> @T["Navigation.Sitemap"]</h2>
<p>@I["Sitemap.Intro"]</p>
<ul class="sitemap headMenu sitemap-category-tree">
    <li><a href="@LocalizedRoutes.Page("/Senast")"><i class="bi bi-clock-history sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Latest"]</a>
        <ul class="sitemap">
            <li><a href="@LocalizedRoutes.Page("/Senast/Fotograferad")"><i class="bi bi-camera sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Photographed"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Senast/Uppladdad")"><i class="bi bi-cloud-arrow-up sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Uploaded"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Senast/Per kategori")"><i class="bi bi-folder sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.ByCategory"]</a></li>
        </ul>
    </li>
    @foreach (var head in byParent[0].OrderBy(c => LocalizedText.Select(c.NameSv, c.NameEn)))
    {
        <li class="sitemap-category-level-0"><a class="sitemap-category-link" href="@LocalizedRoutes.Category(head)"><i class="bi bi-folder2-open" aria-hidden="true"></i> @LocalizedText.Select(head.NameSv, head.NameEn)</a>
            @if (byParent[head.CategoryId.GetValueOrDefault()].Any())
            {
                <ul class="sitemap">
                @foreach (var child in byParent[head.CategoryId.GetValueOrDefault()].OrderBy(c => LocalizedText.Select(c.NameSv, c.NameEn)))
                {
                    <li class="sitemap-category-level-1"><a class="sitemap-category-link" href="@LocalizedRoutes.Category(head, child)"><i class="bi bi-folder" aria-hidden="true"></i> @LocalizedText.Select(child.NameSv, child.NameEn)</a>
                        @if (byParent[child.CategoryId.GetValueOrDefault()].Any())
                        {
                            <ul class="sitemap">
                            @foreach (var grandchild in byParent[child.CategoryId.GetValueOrDefault()].OrderBy(c => LocalizedText.Select(c.NameSv, c.NameEn)))
                            {
                                <li class="sitemap-category-level-2"><a class="sitemap-category-link" href="@LocalizedRoutes.Category(head, child, grandchild)"><i class="bi bi-folder" aria-hidden="true"></i> @LocalizedText.Select(grandchild.NameSv, grandchild.NameEn)</a>
                                    @if (byParent[grandchild.CategoryId.GetValueOrDefault()].Any())
                                    {
                                        <ul class="sitemap">
                                        @foreach (var leaf in byParent[grandchild.CategoryId.GetValueOrDefault()].OrderBy(c => LocalizedText.Select(c.NameSv, c.NameEn)))
                                        {
                                            <li class="sitemap-category-level-3"><a class="sitemap-category-link" href="@LocalizedRoutes.Category(head, child, grandchild, leaf)"><i class="bi bi-tag" aria-hidden="true"></i> @LocalizedText.Select(leaf.NameSv, leaf.NameEn)</a></li>
                                        }
                                        </ul>
                                    }
                                </li>
                            }
                            </ul>
                        }
                    </li>
                }
                </ul>
            }
        </li>
    }
    <li><a href="@LocalizedRoutes.Page("/Info")"><i class="bi bi-info-circle sitemap-page-icon" aria-hidden="true"></i> Info</a>
        <ul class="sitemap">
            <li><a href="@LocalizedRoutes.Page("/Info/Kop_av_bilder")"><i class="bi bi-cart sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.BuyPhotos"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Gastbok")"><i class="bi bi-chat-left-text sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Guestbook"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Kontakta")"><i class="bi bi-envelope sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Contact"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Om_mig")"><i class="bi bi-person sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.About"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Sidkarta")"><i class="bi bi-diagram-3 sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Sitemap"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Copyright")"><i class="bi bi-c-circle sitemap-page-icon" aria-hidden="true"></i> © Copyright</a></li>
        </ul>
    </li>
    <li><a href="@LocalizedRoutes.Search"><i class="bi bi-search sitemap-page-icon" aria-hidden="true"></i> @T["Navigation.Search"]</a></li>
</ul>
