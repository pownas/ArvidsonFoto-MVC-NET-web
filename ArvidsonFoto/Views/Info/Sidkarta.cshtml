@using ArvidsonFoto.Core
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core.Extensions
@using ArvidsonFoto.Core.Interfaces
@using Microsoft.Extensions.Localization
@inject IApiCategoryService CategoryService
@inject IStringLocalizer<SharedResource> T
@{
    var categories = CategoryService.GetAll();
    ViewData["Title"] = T["Sitemap"].Value;
    var byParent = categories.ToLookup(c => c.ParentCategoryId ?? 0);
}
@section MetaData {
    <meta name="robots" content="noimageindex" />
    <meta name="description" content="@T["SitemapDetail"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Sidkarta"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@T["Sitemap"] - Torbjörn Arvidson Foto" />
    <meta name="twitter:description" content="@T["SitemapDetail"]" />
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:title" content="@T["Sitemap"] - Torbjörn Arvidson Foto" />
    <meta property="og:description" content="@T["SitemapDetail"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se@(LocalizedRoutes.Page("/Info/Sidkarta"))" />
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="@LocalizedRoutes.Page("/Info")">Info</a></li>
        <li class="breadcrumb-item active" aria-current="page">@T["Sitemap"]</li>
    </ol>
</nav>
<h2><i class="bi bi-diagram-3"></i> @T["Sitemap"]</h2>
<p>@T["SitemapIntro"]</p>
<ul class="sitemap headMenu">
    <li><a href="@LocalizedRoutes.Page("/Senast")">@T["Latest"]</a>
        <ul class="sitemap">
            <li><a href="@LocalizedRoutes.Page("/Senast/Fotograferad")">@T["Photographed"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Senast/Uppladdad")">@T["Uploaded"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Senast/Per kategori")">@T["ByCategory"]</a></li>
        </ul>
    </li>
    @foreach (var head in byParent[0].OrderBy(c => c.Name))
    {
        <li><a href="@LocalizedRoutes.Category(head)">@head.Name</a>
            @if (byParent[head.CategoryId.GetValueOrDefault()].Any())
            {
                <ul class="sitemap">
                @foreach (var child in byParent[head.CategoryId.GetValueOrDefault()].OrderBy(c => c.Name))
                {
                    <li><a href="@LocalizedRoutes.Category(head, child)">@child.Name</a>
                        @if (byParent[child.CategoryId.GetValueOrDefault()].Any())
                        {
                            <ul class="sitemap">
                            @foreach (var grandchild in byParent[child.CategoryId.GetValueOrDefault()].OrderBy(c => c.Name))
                            {
                                <li><a href="@LocalizedRoutes.Category(head, child, grandchild)">@grandchild.Name</a>
                                    @if (byParent[grandchild.CategoryId.GetValueOrDefault()].Any())
                                    {
                                        <ul class="sitemap">
                                        @foreach (var leaf in byParent[grandchild.CategoryId.GetValueOrDefault()].OrderBy(c => c.Name))
                                        {
                                            <li><a href="@LocalizedRoutes.Category(head, child, grandchild, leaf)">@leaf.Name</a></li>
                                        }
                                        </ul>
                                    }
                                </li>
                            }
                            </ul>
                        }
                    </li>
                }
                </ul>
            }
        </li>
    }
    <li><a href="@LocalizedRoutes.Page("/Info")">Info</a>
        <ul class="sitemap">
            <li><a href="@LocalizedRoutes.Page("/Info/Kop_av_bilder")">@T["BuyPhotos"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Gastbok")">@T["Guestbook"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Kontakta")">@T["Contact"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Om_mig")">@T["About"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Sidkarta")">@T["Sitemap"]</a></li>
            <li><a href="@LocalizedRoutes.Page("/Info/Copyright")">© Copyright</a></li>
        </ul>
    </li>
    <li><a href="@LocalizedRoutes.Search">@T["Search"]</a></li>
</ul>
