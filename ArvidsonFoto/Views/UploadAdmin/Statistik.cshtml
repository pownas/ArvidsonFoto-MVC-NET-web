@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Core.Interfaces
@using ArvidsonFoto.Core.Models
@using ArvidsonFoto.Core.ViewModels
@using ArvidsonFoto.Views.Shared
@model StatisticsViewModel
@section MetaData {
    <meta name="robots" content="noindex" />
}
@{
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.Statistik;
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/uploadadmin">@L["UploadAdmin.Controller.UploadAdmin"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-speedometer2 ms-1"></i></li>
    </ol>
</nav>
<h2 class="offset-md-4"><i class="bi bi-speedometer2 me-2"></i>@ViewData["Title"]</h2>

<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8">
        <p>@L["UploadAdmin.Statistik.HereYouCanSeeSiteStatistics"]</p>
        <div id="page-statistics">
            <partial name="_HomepageStatistics" model="Model" />

            <h4>@L["UploadAdmin.Statistik.AllTimePageViews"]</h4>
            <div class="table-responsive">
            <table class="table table-striped table-dark">
                <thead>
                    <tr>
                        <th scope="col" class="col-3">@L["UploadAdmin.Statistik.Views"]</th>
                        <th scope="col" class="col-5">@L["UploadAdmin.Statistik.Category"]</th>
                        <th scope="col" class="col-4">@L["UploadAdmin.Statistik.LastVisited"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pageViewed in Model.AllTimePageViews)
                    {
                        <tr>
                            <th scope="row">@pageViewed.PageViews</th>
                            <td>@pageViewed.PageName</td>
                            <td>@pageViewed.LastShowDate</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>