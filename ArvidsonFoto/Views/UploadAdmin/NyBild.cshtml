@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core.Interfaces
@model UploadImageViewModel
@inject IApiCategoryService _categoryService
@section MetaData {
    <meta name="robots" content="noindex" />
}
@{ 
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.NyBild;
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/uploadadmin">@L["UploadAdmin.Controller.UploadAdmin"]</a></li>
        @if (Model?.SelectedCategory is not null)
        {
            <li class="breadcrumb-item">@ArvidsonFoto.Core.Extensions.LocalizedText.Select(Model.SelectedCategory.NameSv, Model.SelectedCategory.NameEn)</li>
        }
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-file-image ms-1"></i></li>
    </ol>
</nav>
<h2 class="offset-md-4"><i class="bi bi-file-image me-2"></i>@ViewData["Title"]</h2>

<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8 upload-image-link-content">
        <p>@L["UploadAdmin.NyBild.HereYouCanLinkANewTheSite"]</p>
        
        @* Visa framgångsmeddelande från TempData *@
        @if (TempData["ImageCreated"] as bool? == true)
        {
            var categoryId = TempData["ImageCategoryId"] as int? ?? 0;
            var imageUrl = TempData["ImageUrl"] as string ?? "";
            <h5 class="alert alert-success bg-success text-dark">
                @L["UploadAdmin.NyBild.TheImageWasLinked"] <span class="text-light">@_categoryService.GetNameById(categoryId), @imageUrl</span>
            </h5>
        }
        else if (TempData["ImageCreated"] as bool? == false)
        {
            <div class="alert alert-danger">
                @(TempData["ErrorMessage"] ?? L["Admin.ImageCreationError"].Value)
            </div>
        }
        
        @if (Model!.ImageInputModel is not null && Model.SelectedCategory is not null && Model.SelectedCategory.CategoryId.HasValue)
        {
            <div class="upload-image-category-summary">
                <h3>@L["Admin.SelectedCategory", ArvidsonFoto.Core.Extensions.LocalizedText.Select(Model.SelectedCategory.NameSv, Model.SelectedCategory.NameEn)]</h3>
                @if (!string.IsNullOrWhiteSpace(Model.LatestCategoryImageUrl))
                {
                    <figure class="upload-category-preview">
                        <img src="@Model.LatestCategoryImageUrl" alt="@ArvidsonFoto.Core.Extensions.LocalizedText.Select(Model.SelectedCategory.NameSv, Model.SelectedCategory.NameEn)" loading="lazy" />
                        <figcaption>@L["UploadAdmin.NyBild.LatestCategoryImage", ArvidsonFoto.Core.Extensions.LocalizedText.Select(Model.SelectedCategory.NameSv, Model.SelectedCategory.NameEn)]</figcaption>
                    </figure>
                }
            </div>

            @if (_categoryService.GetSubsList(Model.SelectedCategory.CategoryId.Value).Count.Equals(0))
            {
                Model.ImageInputModel.ImageArt = Model.SelectedCategory.CategoryId.Value;
                if (Model.SelectedCategory.ParentCategoryId is not null)
                    Model.ImageInputModel.ImageFamilj = Model.SelectedCategory.ParentCategoryId;
                
                var parentCategory = _categoryService.GetById(Model.SelectedCategory.ParentCategoryId);
                if (parentCategory != null && parentCategory.ParentCategoryId is not null)
                    Model.ImageInputModel.ImageHuvudfamilj = parentCategory.ParentCategoryId;
                    
                <partial name="_ImageInputForm" model="Model.ImageInputModel" />
            }
        }
        @if (Model.SubCategories is not null)
        {
            <ul class="sitemap">
                @foreach (var category in Model.SubCategories)
                {
                    <li class="my-2">
                        <a class="btn upload-category-choice has-category-tooltip" data-category-id="@category.CategoryId" data-category-name="@ArvidsonFoto.Core.Extensions.LocalizedText.Select(category.NameSv, category.NameEn)" href="@(Model.CurrentUrl + "/" + ArvidsonFoto.Core.Extensions.LocalizedRoutes.CategorySegment(category) + Context.Request.QueryString)">
                            <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            <span>@category.NameSv</span>
                            <i class="bi bi-arrow-right ms-auto" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}