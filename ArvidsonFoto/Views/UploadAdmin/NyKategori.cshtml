@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core.Interfaces
@model UploadNewCategoryInputDto
@inject IApiCategoryService _categoryService
@section MetaData {
    <meta name="robots" content="noindex" />
}
@{
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.NyKategori;
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/UploadAdmin">@L["Text.e1ca68a82880"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-file-font ms-1"></i></li>
    </ol>
</nav>
<h2 class="offset-md-4"><i class="bi bi-file-font me-2"></i>@ViewData["Title"]</h2>

<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8">
        <p>@L["Text.8ffa9b0e7ecf"]</p>
        @if (Model!.CategoryCreated)
        {
            <h5 class="alert alert-success bg-success text-dark">@L["Text.da4add6edabb"] <span class="text-light">@Model.MenuText</span></h5>
        }
        <form method="post" asp-action="@(nameof(UploadAdminController.CreateCategory))">
            @Html.AntiForgeryToken()
            <div class="form-group col-md-6">
                <label asp-for="MainMenuId">@L["Text.c866a7f58a32"]</label>
                <select asp-for="MainMenuId" class="form-control">
                    <option selected disabled value="">@L["Text.5ea3c0b2c666"]</option>
                    @foreach (var category in _categoryService.GetAll().OrderBy(c => c.Name))
                    {
                        <option value="@category.CategoryId">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="MainMenuId"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="MenuText">@L["Text.e9349025558f"]</label>
                <input asp-for="MenuText" type="text" class="form-control">
                <span asp-validation-for="MenuText"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="MenuTextEn">@L["Text.707bc142df6d"]</label>
                <input asp-for="MenuTextEn" class="form-control" maxlength="50" />
                <span asp-validation-for="MenuTextEn"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="MenuUrlSegment">@L["Text.4fc8f82b92c0"]</label>
                <input asp-for="MenuUrlSegment" class="form-control" maxlength="50" />
                <span asp-validation-for="MenuUrlSegment"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="MenuUrlSegmentEn">@L["Text.d2183e4ef2ee"]</label>
                <input asp-for="MenuUrlSegmentEn" class="form-control" maxlength="50" />
                <span asp-validation-for="MenuUrlSegmentEn"></span>
            </div>
            <div class="form-group col-md-6">
                <button type="submit" class="btn btn-light btn-outline-primary text-dark">@L["Text.09f610313b1c"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}