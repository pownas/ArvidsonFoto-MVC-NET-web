@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@using ArvidsonFoto.Core.Interfaces
@model UploadEditImagesViewModel

@inject IApiCategoryService _categoryService

@section MetaData {
    <meta name="robots" content="noindex" />
}
@{
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.RedigeraBilder;
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/UploadAdmin">@L["UploadAdmin.Controller.UploadAdmin"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-pencil-square ms-1"></i></li>
    </ol>
</nav>
<h2 class="offset-md-4"><i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]</h2>
<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8">
        @if (Model!.DisplayMessage is not null && Model.DisplayMessage.Equals("ErrorImgEdit") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-danger bg-danger text-light">@L["UploadAdmin.RedigeraBilder.FailedToEditImageNumber"] <span class="text-dark">@Model.UpdatedId</span></h5>
        }
        else if (Model.DisplayMessage is not null && Model.DisplayMessage.Equals("OkImgDelete") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-success bg-success text-dark">@L["UploadAdmin.RedigeraBilder.DeletedTheLinkForImageNumber"] <span class="text-light">@Model.UpdatedId</span></h5>
        }
        else if (Model.DisplayMessage is not null && Model.DisplayMessage.Equals("OkImgEdit") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-success bg-success text-dark">@L["UploadAdmin.RedigeraBilder.SavedChangesForImage"] <span class="text-light">@_categoryService.GetNameById(Model.UpdatedId)</span></h5>
        }
        <p>@L["UploadAdmin.RedigeraBilder.EditTheLatestImagesBelow"]</p>
        <p class="">@L["UploadAdmin.RedigeraBilder.YouCanScrollHorizontallyOnYourPhone"]</p>
    </div>
</div>
<div class="col-12">
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-dark">
            <thead>
                <tr>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.Image"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.ImageName"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.Species"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.Family"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.MainFamily"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.PhotoDate"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.Description"]</th>
                    <th scope="col">@L["UploadAdmin.RedigeraBilder.Edit"]</th>
                </tr>
            </thead>
            <tbody>
                @try
                {
                    @foreach (var image in Model.DisplayImagesList)
                    {
                        string imgThumbSrc = image.ImageUrlFullSrc + ".thumb.jpg";
                        <tr>
                            <th scope="row"><img src="@imgThumbSrc" alt="@image.ImageArtNamn" width="80" height="80" title="@image.ImageArtNamn"></th>
                            <td>@image.ImageUrl</td>
                            <td>@image.ImageArtNamn</td>
                            <td>@image.ImageFamiljNamn</td>
                            <td>@image.ImageHuvudfamiljNamn</td>
                            <td>@image.ImageDate.ToString("yyyy-MM-dd")</td>
                            <td>@image.ImageDescription</td>
                            <td>
                                <p class="m-0 mb-3">
                                    <button title="Ändra @image.ImageUrl" type="button" class="btn btn-sm btn-primary" style="width:6rem;" data-bs-toggle="modal" data-bs-target="#EditImage-@image.ImageId">
                                        <i class="bi bi-pencil-square me-2"></i> @L["UploadAdmin.RedigeraBilder.Change"]
                                    </button>
                                </p>
                                <p class="m-0">
                                    <button title="Radera @image.ImageUrl" type="button" class="btn btn-sm btn-danger" style="width:6rem;" data-bs-toggle="modal" data-bs-target="#DeleteImage-@image.ImageId">
                                        <i class="bi bi-trash me-2"></i> @L["UploadAdmin.HanteraGB.Delete"]
                                    </button>
                                </p>
                            </td>
                        </tr>
                    }
                }
                catch (Exception ex)
                {
                    <tr>
                        <td colspan="8">@L["UploadAdmin.RedigeraBilder.NoImagesFound"]</td>
                    </tr>
                    Log.Error("Något gick fel på RedigeraBilder-sidan. Felmeddelande: " + ex.Message);
                }
            </tbody>
        </table>
    </div>
    <section id="page-Modals">
        @foreach (var image in Model.DisplayImagesList) //Modal-loop (Popup rutorna Delete och Edit)
        {
            string imgThumbSrc = image.ImageUrlFullSrc + ".thumb.jpg";

            @*<!-- Bootstrap-Modal id=EditImage -->*@
            <div class="modal fade" id="EditImage-@image.ImageId" tabindex="-1" aria-labelledby="EditImage-@image.ImageId-Label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-dark">
                        <div class="modal-header">
                            <h5 class="modal-title" id="EditImage-@image.ImageId-Label">
                                @L["Admin.EditImage", image.ImageUrl, image.ImageArtNamn]
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["UploadAdmin.HanteraGB.Close"]"></button>
                        </div>
                        <partial name="_EditImageInputForm" model="@image" /> @*<!-- Formuläret för att ändra på bilden ligger i denna filen... -->*@
                    </div>
                </div>
            </div>@*<!-- End of Bootstrap-Modal-->*@

            @*<!-- Bootstrap-Modal id=DeleteImage -->*@
            <div class="modal fade" id="DeleteImage-@image.ImageId" tabindex="-1" aria-labelledby="DeleteImage-@image.ImageId-Label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content text-dark">
                        <div class="modal-header">
                            <h5 class="modal-title" id="DeleteImage-@image.ImageId-Label">
                                @L["Admin.DeleteImage", image.ImageUrl, image.ImageArtNamn]
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["UploadAdmin.HanteraGB.Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-center"><img src="@imgThumbSrc" alt="@image.ImageArtNamn" width="120" height="120" title="@image.ImageArtNamn"></p>
                            <p>@L["Admin.ConfirmDeleteImage", image.ImageArtNamn]</p>
                            <p><strong>@L["UploadAdmin.RedigeraBilder.FileName"]</strong> @image.ImageUrl</p>
                            <p><strong>@L["UploadAdmin.RedigeraBilder.Uploaded"]</strong> @image.ImageUpdate.ToString("yyyy-MM-dd HH:mm")</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                @L["UploadAdmin.FacebookUpload.Cancel"] <i class="bi bi-x-circle"></i>
                            </button>
                            <a href="/UploadAdmin/DeleteImage?imgId=@image.ImageId" class="btn btn-danger">
                                @L["UploadAdmin.HanteraGB.Delete"] <i class="bi bi-trash"></i>
                            </a>
                            @*<a onclick="alert('Hoppsan, denna funktionen fungerar inte än!')" class="btn btn-danger">
                                Radera bilden <i class="bi bi-trash"></i>
                            </a>*@
                        </div>
                    </div>
                </div>
            </div>@*<!-- End of Bootstrap-Modal-->*@
        }
    </section>

    <p id="page-image-counter-bottom" class="text-center">@L["Admin.ImageCount", Model.DisplayImagesList.Count, Model.CurrentPage, Model.TotalPages]</p>
    @if (Model.TotalPages > 1) // === Page-counter (Sidräknaren) ===
    {
        <nav id="page-paging-bottom" aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)">@L["UploadAdmin.RedigeraBilder.First"]</a></li>
                    <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.CurrentPage - 1)" aria-label="@L["UploadAdmin.RedigeraBilder.Previous"]"><span aria-hidden="true">« @(Model.CurrentPage - 1)</span></a></li>
                }
                else
                {
                    <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">@L["UploadAdmin.RedigeraBilder.First"]</a></li>
                    <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">«</a></li>
                }
                <li class="page-item active"><a class="page-link" aria-label="@L["UploadAdmin.RedigeraBilder.Current"]">@(Model.CurrentPage)<span class="sr-only"> @L["UploadAdmin.RedigeraBilder.Current2"]</span></a></li>
                @if (Model.CurrentPage == Model.TotalPages)
                {
                    <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true"> »</a></li>
                    <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">@L["UploadAdmin.RedigeraBilder.Last"]</a></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.CurrentPage + 1)" aria-label="@L["UploadAdmin.RedigeraBilder.Next"]">@(Model.CurrentPage + 1) »</a></li>
                    <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.TotalPages)">@L["UploadAdmin.RedigeraBilder.Last"]</a></li>
                }
            </ul>
        </nav>
    }@*// === Slutet på page-counter (Paging, sidnumreringen) ===*@
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}