@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Core.Models
@using ArvidsonFoto.Core.ViewModels
@model StatisticsViewModel
@{
    var monthPagesCount = Model.PageViews;
    var top10Categories = Model.CategoryViews.Take(10).ToList();
    var top10AllTimePageViews = Model.AllTimePageViews.Take(10).ToList();
    var currentPageTotal = Model.MonthlyPageViews.Values.Sum();
    var currentCategoryTotal = Model.MonthlyCategoryViews.Values.Sum();
    var previousPageTotal = Model.PreviousYearPageViews.Values.Sum();
    var previousCategoryTotal = Model.PreviousYearCategoryViews.Values.Sum();
}

<form method="get" action="/uploadadmin/statistik" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <label for="statistics-period" class="form-label">@L["UploadAdmin.Statistics.Period"]</label>
        <select id="statistics-period" name="period" class="form-select">
            <option value="month" selected="@(Model.Period == "month")">@L["UploadAdmin.Statistics.CurrentMonth"]</option>
            <option value="3m" selected="@(Model.Period == "3m")">@L["UploadAdmin.Statistics.Last3Months"]</option>
            <option value="6m" selected="@(Model.Period == "6m")">@L["UploadAdmin.Statistics.Last6Months"]</option>
            <option value="12m" selected="@(Model.Period == "12m")">@L["UploadAdmin.Statistics.Last12Months"]</option>
            <option value="year" selected="@(Model.Period == "year")">@L["UploadAdmin.Statistics.CurrentYear"]</option>
            <option value="custom" selected="@(Model.Period == "custom")">@L["UploadAdmin.Statistics.CustomPeriod"]</option>
        </select>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
        <label for="statistics-from" class="form-label">@L["UploadAdmin.Statistics.From"]</label>
        <input id="statistics-from" type="month" name="fromMonth" class="form-control" value="@Model.StartDate.ToString("yyyy-MM")" />
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
        <label for="statistics-to" class="form-label">@L["UploadAdmin.Statistics.To"]</label>
        <input id="statistics-to" type="month" name="toMonth" class="form-control" value="@Model.EndDate.ToString("yyyy-MM")" />
    </div>
    <div class="col-12 col-lg-3">
        <div class="form-check">
            <input id="statistics-compare" type="checkbox" name="compare" value="true" class="form-check-input" checked="@Model.CompareWithPreviousYear" />
            <label for="statistics-compare" class="form-check-label">@L["UploadAdmin.Statistics.ComparePreviousYear"]</label>
        </div>
    </div>
    <div class="col-12 col-lg-2">
        <button type="submit" class="btn btn-primary w-100">@L["UploadAdmin.Statistics.Show"]</button>
    </div>
</form>
<p class="text-secondary">@L["UploadAdmin.Statistics.SelectedPeriod", Model.StartDate.ToString("yyyy-MM"), Model.EndDate.ToString("yyyy-MM")]</p>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-body">
                <h5 class="card-title">@L["Admin.Views"]</h5>
                <p class="display-6 mb-0">@currentPageTotal.ToString("N0")</p>
                @if (Model.CompareWithPreviousYear)
                {
                    <small class="text-secondary">@L["UploadAdmin.Statistics.PreviousYearTotal", previousPageTotal.ToString("N0")]</small>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-body">
                <h5 class="card-title">@L["Admin.CategoryViews"]</h5>
                <p class="display-6 mb-0">@currentCategoryTotal.ToString("N0")</p>
                @if (Model.CompareWithPreviousYear)
                {
                    <small class="text-secondary">@L["UploadAdmin.Statistics.PreviousYearTotal", previousCategoryTotal.ToString("N0")]</small>
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart.js för sidvisningar per månad -->
<div class="mb-4">
    <h4>@L["UploadAdmin.Statistics.Trend"]</h4>
    <div class="upload-admin-chart">
        <canvas id="pageViewsChart" role="img" aria-label="@L["UploadAdmin.Statistics.Trend"]"></canvas>
    </div>
</div>

<h4>@L["UploadAdmin.Statistics.PageViewsInPeriod"]</h4>
<div class="upload-admin-chart mb-2">
    <canvas id="monthPageViewsChart" role="img" aria-label="@L["UploadAdmin.Statistics.PageViewsInPeriod"]"></canvas>
</div>
<details class="mb-4">
    <summary>@L["Admin.ShowStatisticsTable"]</summary>
    <div class="table-responsive mt-2">
        <table class="table table-striped table-dark">
            <thead>
                <tr>
                    <th scope="col" class="col-3">@L["UploadAdmin.Statistik.Views"]</th>
                    <th scope="col" class="col-5">@L["UploadAdmin.Statistik.Category"]</th>
                    <th scope="col" class="col-4">@L["UploadAdmin.Statistik.LastVisited"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pageViewed in monthPagesCount)
                {
                    <tr>
                        <th scope="row">@pageViewed.PageViews</th>
                        <td>@pageViewed.PageName</td>
                        <td>@pageViewed.LastShowDate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

<h4>@L["UploadAdmin.Statistics.CategoriesInPeriod"]</h4>
<div class="upload-admin-chart mb-2">
    <canvas id="monthCategoryViewsChart" role="img" aria-label="@L["UploadAdmin.Statistics.CategoriesInPeriod"]"></canvas>
</div>
<details class="mb-4">
    <summary>@L["Admin.ShowStatisticsTable"]</summary>
    <div class="table-responsive mt-2">
        <table class="table table-striped table-dark">
            <thead>
                <tr>
                    <th scope="col" class="col-3">@L["UploadAdmin.Statistik.Views"]</th>
                    <th scope="col" class="col-5">@L["UploadAdmin.Statistik.Category"]</th>
                    <th scope="col" class="col-4">@L["UploadAdmin.Statistik.LastVisited"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in top10Categories)
                {
                    <tr>
                        <th scope="row">@category.PageViews</th>
                        <td>@category.PageName</td>
                        <td>@category.LastShowDate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

<!-- Chart.js Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Förbereda data för grafen
    const pageViewsData = @Html.Raw(Json.Serialize(Model.MonthlyPageViews));
    const categoryViewsData = @Html.Raw(Json.Serialize(Model.MonthlyCategoryViews));
    const previousPageViewsData = @Html.Raw(Json.Serialize(Model.PreviousYearPageViews));
    const previousCategoryViewsData = @Html.Raw(Json.Serialize(Model.PreviousYearCategoryViews));
    const compareWithPreviousYear = @Html.Raw(Json.Serialize(Model.CompareWithPreviousYear));
    const monthPageViews = @Html.Raw(Json.Serialize(monthPagesCount.Take(10).Select(page => new { label = page.PageName, value = page.PageViews })));
    const monthCategoryViews = @Html.Raw(Json.Serialize(top10Categories.Select(category => new { label = category.PageName, value = category.PageViews })));
    const top10AllTimePageViews = @Html.Raw(Json.Serialize(top10AllTimePageViews.Select(page => new { label = page.PageName, value = page.PageViews })));
    
    const months = Object.keys(pageViewsData);
    const pageViews = Object.values(pageViewsData);
    const categoryViews = Object.values(categoryViewsData);
    const previousPageViews = Object.values(previousPageViewsData);
    const previousCategoryViews = Object.values(previousCategoryViewsData);
    
    // Formatera månadslabels för bättre visning
    const monthLabels = months.map(month => {
        const date = new Date(month + '-15');
        return date.toLocaleDateString('@System.Globalization.CultureInfo.CurrentUICulture.Name', { year: 'numeric', month: 'short' });
    });
    
    // Kontrollera om Chart.js har laddats
    if (typeof Chart !== 'undefined') {
        const ctx = document.getElementById('pageViewsChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.Views"].Value)),
                    data: pageViews,
                    borderColor: '#45c5d0',
                    backgroundColor: 'rgba(69, 197, 208, 0.2)',
                    pointBackgroundColor: '#45c5d0',
                    tension: 0.1
                }, {
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.CategoryViews"].Value)),
                    data: categoryViews,
                    borderColor: '#ff7795',
                    backgroundColor: 'rgba(255, 119, 149, 0.2)',
                    pointBackgroundColor: '#ff7795',
                    tension: 0.1
                }, ...(compareWithPreviousYear ? [{
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["UploadAdmin.Statistics.PreviousYearPageViews"].Value)),
                    data: previousPageViews,
                    borderColor: 'rgba(69, 197, 208, 0.65)',
                    borderDash: [6, 4],
                    pointBackgroundColor: 'rgba(69, 197, 208, 0.65)',
                    tension: 0.1
                }, {
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["UploadAdmin.Statistics.PreviousYearCategoryViews"].Value)),
                    data: previousCategoryViews,
                    borderColor: 'rgba(255, 119, 149, 0.65)',
                    borderDash: [6, 4],
                    pointBackgroundColor: 'rgba(255, 119, 149, 0.65)',
                    tension: 0.1
                }] : [])
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(255, 255, 255, 0.16)' },
                        ticks: { color: '#d6d6d6', precision: 0 }
                    },
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: {
                            color: '#d6d6d6'
                        }
                    }
                },
                plugins: {
                    title: {
                        display: true,
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.ChartTitle"].Value)),
                        color: '#f2f2f2'
                    },
                    legend: {
                        display: true,
                        labels: { color: '#f2f2f2' }
                    }
                }
            }
        });
    } else {
        // Fallback: visa data i tabellformat om Chart.js inte kan laddas
        const canvas = document.getElementById('pageViewsChart');
        const fallbackDiv = document.createElement('div');
        fallbackDiv.className = 'alert alert-info';
        const heading = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.ChartFallback"].Value));
        const monthHeading = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.Month"].Value));
        const viewsHeading = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.Views"].Value));
        const categoryHeading = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.CategoryViews"].Value));
        fallbackDiv.innerHTML = `
            <h5>${heading}</h5>
            <table class="table table-sm table-striped">
                <thead>
                    <tr><th>${monthHeading}</th><th>${viewsHeading}</th><th>${categoryHeading}</th></tr>
                </thead>
                <tbody>
                    ${monthLabels.map((label, i) => 
                        `<tr><td>${label}</td><td>${pageViews[i]}</td><td>${categoryViews[i]}</td></tr>`
                    ).join('')}
                </tbody>
            </table>
        `;
        canvas.parentNode.replaceChild(fallbackDiv, canvas);
    }

    if (typeof Chart !== 'undefined') {
        const viewsLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.Views"].Value));
        const createHorizontalBarChart = (canvasId, data, color) => {
            const canvas = document.getElementById(canvasId);
            if (!canvas) {
                return;
            }

            new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: data.map(item => item.label),
                    datasets: [{
                        data: data.map(item => item.value),
                        backgroundColor: color,
                        borderColor: color,
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                plugins: [{
                    id: 'barValueLabels',
                    afterDatasetsDraw: chart => {
                        const { ctx } = chart;
                        const values = chart.data.datasets[0].data;
                        ctx.save();
                        ctx.fillStyle = '#f2f2f2';
                        ctx.font = '600 12px sans-serif';
                        chart.getDatasetMeta(0).data.forEach((bar, index) => {
                            ctx.textBaseline = 'middle';
                            ctx.fillText(new Intl.NumberFormat().format(values[index]), bar.x + 6, bar.y);
                        });
                        ctx.restore();
                    }
                }],
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: context => `${new Intl.NumberFormat().format(context.raw)} ${viewsLabel}`
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            suggestedMax: Math.max(1, ...data.map(item => item.value)) * 1.18,
                            grid: { color: 'rgba(255, 255, 255, 0.16)' },
                            ticks: { color: '#d6d6d6', precision: 0 }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { color: '#f2f2f2', autoSkip: false }
                        }
                    }
                }
            });
        };

        createHorizontalBarChart('monthPageViewsChart', monthPageViews, 'rgba(69, 197, 208, 0.8)');
        createHorizontalBarChart('monthCategoryViewsChart', monthCategoryViews, 'rgba(255, 119, 149, 0.85)');
        createHorizontalBarChart('allTimePageViewsChart', top10AllTimePageViews, 'rgba(69, 197, 208, 0.8)');
    } else {
        const fallbackText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Admin.ChartFallback"].Value));
        ['monthPageViewsChart', 'monthCategoryViewsChart', 'allTimePageViewsChart'].forEach(canvasId => {
            const canvas = document.getElementById(canvasId);
            if (!canvas) {
                return;
            }

            const fallback = document.createElement('p');
            fallback.className = 'alert alert-info';
            fallback.textContent = fallbackText;
            canvas.parentNode.replaceChild(fallback, canvas);
        });
    }
});
</script>