@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@using ArvidsonFoto.Core.Models
@model UploadGbViewModel

@inject IGuestBookService _guestBookService
@{
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.HanteraGB;
    List<TblGb> gbListView = new List<TblGb>();
    gbListView = _guestBookService.GetAll();
}

@section MetaData {
    <meta name="robots" content="noindex, nofollow" />
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/UploadAdmin">@L["UploadAdmin.Controller.UploadAdmin"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-book-half ms-1"></i></li>
    </ol>
</nav>

<h2 class="offset-md-4"><i class="bi bi-book-half me-2"></i>@ViewData["Title"]</h2>

<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8">
        @if (Model!.DisplayMessage.Equals("ErrorGbDelete"))
        {
            <h5 class="alert alert-danger bg-danger text-light">@L["UploadAdmin.HanteraGB.FailedToDeleteGuestbookEntryNumber"] <span class="text-dark">@Model.UpdatedId</span></h5>
        }
        else if (Model.DisplayMessage.Equals("OkGbDelete") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-success bg-success text-dark">@L["UploadAdmin.HanteraGB.DeletedGuestbookEntryNumber"] <span class="text-light">@Model.UpdatedId</span></h5>
        }
        else if (Model.DisplayMessage.Equals("OkGbRead") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-success bg-success text-dark">@L["UploadAdmin.HanteraGB.MarkedGuestbookEntryNumberAsRead"] <span class="text-light">@Model.UpdatedId</span></h5>
        }
        else if (Model.DisplayMessage.Equals("ErrorGbRead") && Model.UpdatedId is not null)
        {
            <h5 class="alert alert-danger bg-danger text-light">@L["UploadAdmin.HanteraGB.FailedToMarkGuestbookEntryNumberAsRead"] <span class="text-dark">@Model.UpdatedId</span></h5>
        }
        <p>@L["UploadAdmin.HanteraGB.ManageGuestbookEntriesHere"]</p>
        <div class="row row-cols-1">
            @if (_guestBookService is not null && gbListView is not null)
            {
                @foreach (var gbPost in gbListView)
                {
                    DateTime gbDate = gbPost.GbDate ?? new DateTime(1900, 01, 01);
                    string gbName = (gbPost.GbName is not null) ? gbPost.GbName : "Anonym användare";

                    <div class="col mb-4">
                        <div class="card text-left text-dark">
                            <div class="card-header row">
                                <div class="text-left col-6">
                                    <p class="my-1"><strong>@gbName</strong></p>
                                </div>
                                <div class="text-right col-6">
                                    @if (gbPost.GbReadPost is not true)
                                    {
                                        <a title="@L["UploadAdmin.HanteraGB.MarkAsRead"]" href="/UploadAdmin/MarkGbPostAsRead?gbId=@gbPost.GbId" class="btn btn-sm btn-success my-1">
                                            <i class="bi bi-check2-square me-2"></i> @L["UploadAdmin.HanteraGB.MarkAsRead"]
                                        </a>
                                    }
                                    @if (gbPost.GbEmail is not null && gbPost.GbEmail.Contains("@"))
                                    {
                                        <a title="Svara via Outlook" class="btn btn-sm btn-primary my-1" href="mailto:@gbPost.GbEmail?subject=Svar%20på%20gästboks-inlägget%20du%20skrev%20på%20min%20hemsida:%20ArvidsonFoto.se" target="_blank" rel="noopener noreferrer">
                                            <i class="bi bi-pencil-square me-2"></i>@L["UploadAdmin.HanteraGB.Reply"]
                                        </a>
                                    }
                                    <button title="@L["UploadAdmin.HanteraGB.Delete"]" type="button" class="btn btn-sm btn-danger my-1" data-bs-toggle="modal" data-bs-target="#DeleteMessage-@gbPost.GbId">
                                        <i class="bi bi-trash me-2"></i>@L["UploadAdmin.HanteraGB.Delete"]
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-dark">@gbPost.GbText</p>
                            </div>
                            <div class="card-footer text-muted row">
                                <div class="text-left col-6">
                                    @if (gbPost.GbHomepage is not null)
                                    {<span class="card-text badge badge-info text-dark">@gbPost.GbHomepage</span>}
                                </div>
                                <div class="text-right col-6">@gbDate.ToString("yyyy-MM-dd")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Bootstrap-Modal id=DeleteMessage -->
                    <div class="modal fade" id="DeleteMessage-@gbPost.GbId" tabindex="-1" aria-labelledby="DeleteMessage-@gbPost.GbId-Label" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content text-dark">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="DeleteMessage-@gbPost.GbId-Label">
                                        @L["Admin.ConfirmDeleteGuestbook", gbName]
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["UploadAdmin.HanteraGB.Close"]"></button>
                                </div>
                                <div class="modal-body">
                                    <p><strong>@L["UploadAdmin.HanteraGB.MessageText"]</strong> @gbPost.GbText <br /></p>
                                    <p><strong>@L["UploadAdmin.HanteraGB.Received"]</strong> @gbDate.ToString("yyyy-MM-dd HH:mm")</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        @L["UploadAdmin.FacebookUpload.Cancel"] <i class="bi bi-x-circle"></i>
                                    </button>
                                    <a href="/UploadAdmin/DeleteGbPost?gbId=@gbPost.GbId" class="btn btn-danger">
                                        @L["UploadAdmin.HanteraGB.Delete"] <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>