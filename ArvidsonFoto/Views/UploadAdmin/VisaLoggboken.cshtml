@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@model UploadLogReaderViewModel
@section MetaData {
    <meta name="robots" content="noindex" />
}
@{
    ViewData["ActiveUploadPage"] = UploadAdminNavPages.VisaLoggboken;

    ViewData["Title"] = ViewData["Title"]?.ToString()?.Replace("mandag", "måndag");
    ViewData["Title"] = ViewData["Title"]?.ToString()?.Replace("tirsdag", "tisdag");
    ViewData["Title"] = ViewData["Title"]?.ToString()?.Replace("lørdag", "lördag");
    ViewData["Title"] = ViewData["Title"]?.ToString()?.Replace("søndag", "söndag");
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item"><a href="/uploadadmin">@L["UploadAdmin.Controller.UploadAdmin"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]<i class="bi bi-journal-code ms-1"></i></li>
    </ol>
</nav>
<h2 class="offset-md-4"><i class="bi bi-journal-code me-2"></i>@ViewData["Title"]</h2>

<div class="row">
    <nav class="nav nav-pills col-12 col-md-4 p-0">
        <ul class="p-0 col-11">
            <partial name="_NavUploadAdmin" />
        </ul>
    </nav>
    <div class="col-12 col-md-8">
        <p>@L["UploadAdmin.VisaLoggboken.ChooseADayToView"]</p>
        <p>
            @{ //Start på kalender-vy
                var getDate = Model!.DateShown;

                var firstDayOfTheMonth = new DateTime(getDate.Year, getDate.Month, 1);
                var lastDayOfTheMonth = firstDayOfTheMonth.AddMonths(1).AddDays(-1);

                var numberOfDays = Convert.ToInt16(lastDayOfTheMonth.ToString("dd"));
                DateTime startDate = firstDayOfTheMonth.AddDays(-(int)firstDayOfTheMonth.DayOfWeek);

                var previousMonth = getDate.AddMonths(-1).ToString("yyyy-MM-dd");
                var yesterDay = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd");
            }

            <a href="/uploadadmin/visaloggboken?datum=@previousMonth">@L["UploadAdmin.VisaLoggboken.PreviousMonth"]</a> | <a href="/uploadadmin/visaloggboken?datum=@yesterDay">@L["UploadAdmin.VisaLoggboken.LatestLogYesterday"]</a>
            <table class="table table-striped table-bordered table-dark text-center" style="width: 23rem;">
                <thead>
                    <tr>
                        <th>@L["Admin.Week"]</th>
                        <th>@L["Admin.Mon"]</th>
                        <th>@L["Admin.Tue"]</th>
                        <th>@L["Admin.Wed"]</th>
                        <th>@L["Admin.Thu"]</th>
                        <th>@L["Admin.Fri"]</th>
                        <th>@L["Admin.Sat"]</th>
                        <th>@L["Admin.Sun"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>@SharedStaticFunctions.GetWeekNumber(firstDayOfTheMonth)</th>
                        @for (int i = 0; i < 42; i++)
                        {
                            DateTime date = startDate.AddDays(i + 1); //Lägger till +1 för att justera för amerikanska söndagen...
                            if (i % 7 == 0 && i > 0) //start a new row every 7 days
                            {
                                if (i > 29 && date.Day > 5)
                                {
                                @:</tr><tr class="d-none">
                                }
                                else
                                {
                                @:</tr><tr>
                                    <th>@SharedStaticFunctions.GetWeekNumber(date.AddDays(1))</th>
                                }
                            }

                            if (getDate.ToString("yyyy-MM-dd") == date.ToString("yyyy-MM-dd"))
                            {
                                <td class="bg-primary">@date.Day</td>
                            }
                            else if (DateTime.Now.ToString("yyyy-MM-dd") == date.ToString("yyyy-MM-dd"))
                            {
                                <td class="bg-secondary">@L["UploadAdmin.VisaLoggboken.Today"]</td>
                            }
                            else
                            {
                                bool fileExist = false;
                                foreach (var item in Model.ExistingLogFiles)
                                {
                                    if (item.Equals(date.ToString("yyyyMMdd")))
                                        fileExist = true;
                                }

                                if (fileExist)
                                {
                                    <td><a href="/uploadadmin/visaloggboken?datum=@date.ToString("yyyy-MM-dd")">@date.Day</a></td>
                                }
                                else
                                {
                                    <td>@date.Day</td>
                                }
                            }
                        }
                    </tr>
                </tbody>
            </table>
        </p>
        <form asp-action="ToggleShowAllLogs" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="date" value="@Model.DateShown.ToString("yyyy-MM-dd")" />
            @if (Model.ShowAllLogs)
            {
                <button type="submit" class="btn btn-outline-danger">@L["UploadAdmin.VisaLoggboken.HideFilteredLogs"]</button>
            }
            else
            {
                <button type="submit" class="btn btn-success">@L["UploadAdmin.VisaLoggboken.ShowAllLogs"]</button>
            }
        </form>
        <form asp-action="SearchLogbook" method="post" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="datum" value="@Model.DateShown.ToString("yyyy-MM-dd")" />
            <div class="col-12 col-md-6">
                <label for="log-search" class="form-label">@L["UploadAdmin.Logbook.Search"]</label>
                <input id="log-search" type="search" name="search" value="@Model.SearchQuery" maxlength="100" class="form-control" />
            </div>
            <div class="col-12 col-md-4">
                <label for="log-level" class="form-label">@L["UploadAdmin.Logbook.Level"]</label>
                <select id="log-level" name="level" class="form-select">
                    <option value="all" selected="@(Model.LevelFilter == "all")">@L["UploadAdmin.Logbook.AllLevels"]</option>
                    <option value="error" selected="@(Model.LevelFilter == "error")">@L["UploadAdmin.Logbook.Error"]</option>
                    <option value="warning" selected="@(Model.LevelFilter == "warning")">@L["UploadAdmin.Logbook.Warning"]</option>
                    <option value="info" selected="@(Model.LevelFilter == "info")">@L["UploadAdmin.Logbook.Information"]</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">@L["UploadAdmin.Review.Search"]</button>
                <a class="btn btn-outline-secondary" href="/uploadadmin/visaloggboken?datum=@Model.DateShown.ToString("yyyy-MM-dd")">@L["UploadAdmin.Images.Reset"]</a>
            </div>
        </form>
        <p role="status">@L["UploadAdmin.Logbook.ResultCount", Model.FilteredCount]</p>
        <p>@L["UploadAdmin.VisaLoggboken.TheSiteSLogsAreShownBelow"]</p>
        @{
            foreach (var line in Model.LogBook)
            {
                var lineColor = line.Contains("[INF]") ? "admin-log-entry--info"
                    : line.Contains("[WRN]") ? "admin-log-entry--warning"
                    : line.Contains("[ERR]") ? "admin-log-entry--error"
                    : "";
                <p class="admin-log-entry text-break mb-1 @lineColor">@line</p>
            }

            if (Model.FilteredCount is 0)
            {
                <p class="text-break mb-1">@L["UploadAdmin.Logbook.NoResults"]</p>
            }
        }
    </div>
</div>