@using Microsoft.AspNetCore.Identity
@inject IStringLocalizer<SharedResource> T
@inject SignInManager<ArvidsonFotoUser> SignInManager
@inject UserManager<ArvidsonFotoUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    string username = User.Identity!.Name ?? "";
    string[] splittedUser = username!.Split("@");
    username = splittedUser[0];
    <li class="nav-item">
        <div class="dropdown-divider"></div>
        <a href="./UploadAdmin" title="@T["Navigation.Admin"]"><i class="bi bi-cloud-upload"></i> @T["Navigation.Admin"]</a>
    </li>
    <li class="nav-item">
        <a asp-area="Identity" asp-page="/Account/Manage/Index" title="@T["Navigation.ManageAccountTitle"]"><i class="bi bi-file-person"></i> @T["Navigation.ManageAccount", username]</a>
    </li>
    <li class="nav-item">
        <a asp-area="Identity" asp-page="/Account/Logout"><i class="bi bi-lock"></i> @T["Navigation.LogOut"]</a>
    </li>
}
else
{
    @*<!-- Skulle kunna visa en logga in knapp här om användaren vill kunna logga in... -->
    <li class="nav-item">
        <div class="dropdown-divider"></div>
        <a asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-unlock"></i> Logga in</a>
    </li>*@
}