@using ArvidsonFoto.Core.Extensions
@inject ArvidsonFoto.Core.Interfaces.IApiCategoryService CategoryService
<!DOCTYPE html>
<html lang="@(ArvidsonFoto.Core.Extensions.LocalizedText.IsEnglish ? "en" : "sv")" data-bs-theme="dark">
<head>
    <!-- Character encoding -->
    <meta charset="utf-8" />
    <!-- Viewport for responsive design -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Site version and last modified content -->
    @{
        var appVersion = typeof(ArvidsonFoto.Controllers.HomeController).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), inherit: false)
            .Cast<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()
            ?.InformationalVersion ?? "unknown";
        var appVersionInfo = appVersion.Split('+');
        var commitId = appVersionInfo.Length > 1 ? appVersionInfo[1] : appVersion;

        var assemblyPath = typeof(ArvidsonFoto.Controllers.HomeController).Assembly.Location;
        var lastModifiedUtc = !string.IsNullOrWhiteSpace(assemblyPath) && System.IO.File.Exists(assemblyPath)
            ? new DateTimeOffset(System.IO.File.GetLastWriteTimeUtc(assemblyPath), TimeSpan.Zero)
            : DateTimeOffset.UtcNow;

        var lastModifiedLocal = lastModifiedUtc.ToLocalTime();
    }
    <meta name="ArvidsonFoto-version" content="v@(appVersion)" />
    <meta name="ArvidsonFoto-commit" content="https://github.com/pownas/ArvidsonFoto-MVC-NET-web/commit/@(commitId)" />
    <meta name="last-modified" content="@lastModifiedLocal.ToString("O")">
    <partial name="_MetaData" />
    @await RenderSectionAsync("MetaData", required: false)
    <title>@ViewData["Title"] - ArvidsonFoto.se</title>
    <base href="~/" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> @*<!-- Se info i "wwwroot/css/site.scss" för alla CSS-imports... -->*@
</head>
<body>
    <header>
        <partial name="_NavBar" />
        @{
            var existingQuery = Context.Request.Query
                .Where(pair => pair.Key != "culture")
                .SelectMany(pair => pair.Value.Select(value => new KeyValuePair<string, string?>(pair.Key, value)));
            string LanguageLink(string culture) =>
                Context.Request.PathBase.ToString() + LocalizedRoutes.Switch(Context.Request.Path.Value ?? "/",
                    culture == "en-US", CategoryService.GetAll()) +
                QueryString.Create(existingQuery.Append(new KeyValuePair<string, string?>("culture", culture)));
            var english = ArvidsonFoto.Core.Extensions.LocalizedText.IsEnglish;
        }
    </header>
    <main class="container-md pb-5">
        @RenderBody()
    </main>
    <section class="site-pre-footer-controls" aria-label="@(english ? "Language and appearance settings" : "Språk- och utseendeinställningar")">
        <nav aria-label="Language / Språk" class="page-language-switcher">
            <a href="@LanguageLink("sv-SE")" lang="sv" hreflang="sv" class="btn btn-sm @(english ? "btn-outline-light" : "btn-light")" aria-current="@(english ? null : "true")"><svg aria-hidden="true" width="20" height="14" viewBox="0 0 32 20"><path fill="#006aa7" d="M0 0h32v20H0z"/><path fill="#fecc00" d="M10 0h4v20h-4zM0 8h32v4H0z"/></svg> Svenska</a>
            <a href="@LanguageLink("en-US")" lang="en" hreflang="en" class="btn btn-sm @(english ? "btn-light" : "btn-outline-light")" aria-current="@(english ? "true" : null)"><svg aria-hidden="true" width="20" height="14" viewBox="0 0 32 20"><path fill="#012169" d="M0 0h32v20H0z"/><path stroke="#fff" stroke-width="5" d="m0 0 32 20M32 0 0 20"/><path stroke="#c8102e" stroke-width="2" d="m0 0 32 20M32 0 0 20"/><path fill="#fff" d="M0 7h32v6H0zM13 0h6v20h-6z"/><path fill="#c8102e" d="M0 8.5h32v3H0zM14.5 0h3v20h-3z"/></svg> English</a>
        </nav>
        <div class="theme-switcher">
            <p id="theme-switcher-description">@(english ? "Switch between dark mode and light mode" : "Växla mellan mörkt och ljust läge")</p>
            <button type="button" id="dark-mode-toggle" class="btn btn-secondary" aria-describedby="theme-switcher-description" aria-label="@(english ? "Switch to light mode" : "Växla till ljust läge")" data-label-light="@(english ? "Switch to light mode" : "Växla till ljust läge")" data-label-dark="@(english ? "Switch to dark mode" : "Växla till mörkt läge")" title="@(english ? "Switch to light mode" : "Växla till ljust läge")"><span id="dark-mode-toggle-btn-text">@(english ? "Switch to dark mode" : "Växla till mörkt läge")</span> <i class="bi bi-lightbulb" aria-hidden="true"></i></button>
        </div>
    </section>
    <footer class="footer overridden-footer">
        <div class="container">
            <partial name="_Footer" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script> @*<!-- version: 3.5.1 - Required for jQuery.smartmenus and other plugins -->*@
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script> @*<!-- version: 5.3.3-dist (includes Popper v2, no longer requires jQuery) -->*@
    <script src="~/lib/jQuery.smartmenus/jquery.smartmenus.min.js" asp-append-version="true"></script> @*<!-- version: 1.1.1 -->*@
    <script src="~/lib/jQuery.smartmenus/smartmenu.js" asp-append-version="true"></script> @*<!-- version: 1.1.1 -->*@
    <script src="~/lib/glightbox/js/glightbox.min.js" asp-append-version="true"></script> @*<!-- version: 3.0.7 -->*@
    <script src="~/js/gLightBoxOptions.js" asp-append-version="true"></script> @*<!-- Egna inställningar till glightbox -->*@
    <script src="~/js/categoryCache.js" asp-append-version="true"></script> @*<!-- Client-side category caching with localStorage -->*@
    <script src="~/js/categoryTooltip.js" asp-append-version="true"></script> @*<!-- Category tooltip with image preview -->*@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>