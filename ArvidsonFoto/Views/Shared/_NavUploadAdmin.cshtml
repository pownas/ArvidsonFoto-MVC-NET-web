@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.UploadAdminResource> L
@using ArvidsonFoto.Views.Shared
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ArvidsonFotoUser> SignInManager
@inject UserManager<ArvidsonFotoUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    @inject IGuestBookService _guestBookService
    int countOfUnreadGbPosts = _guestBookService.GetCountOfUnreadPosts();

    string username = User.Identity!.Name ?? "";
    string[] splittedUser = username!.Split("@");
    username = splittedUser[0];

    <a href="./UploadAdmin" class="nav-link @UploadAdminNavPages.IndexNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.IndexNavClass(ViewContext) is not null ? "page" : null)"><i class="bi bi-cloud-upload" aria-hidden="true"></i> @L["UploadAdmin.Controller.UploadAdmin"]</a>
    <ul class="p-0 sitemap">
        <li><a href="./UploadAdmin/NyBild" class="nav-link @UploadAdminNavPages.NyBildNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.NyBildNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.LinkANewImageOnTheSite"]"><i class="bi bi-file-image" aria-hidden="true"></i> @L["UploadAdmin.Navigation.NewImage"]</a></li>
        <li><a href="./UploadAdmin/NyKategori" class="nav-link @UploadAdminNavPages.NyKategoriNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.NyKategoriNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.AddANewCategoryOnTheSite"]"><i class="bi bi-file-font" aria-hidden="true"></i> @L["UploadAdmin.Navigation.NewCategory"]</a></li>
        <li><a asp-controller="UploadAdmin" asp-action="RedigeraKategori" class="nav-link @UploadAdminNavPages.RedigeraKategoriNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.RedigeraKategoriNavClass(ViewContext) is not null ? "page" : null)"><i class="bi bi-translate" aria-hidden="true"></i> @L["UploadAdmin.Navigation.EditCategoriesAndSpecies"]</a></li>
        <li><a asp-controller="TranslationReview" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TranslationReview" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "TranslationReview" ? "page" : null)"><i class="bi bi-check2-square" aria-hidden="true"></i> @L["UploadAdmin.Review.Title"]</a></li>
        <li>
            <div class="dropdown-divider"></div>
            <a href="./UploadAdmin/RedigeraBilder" class="nav-link @UploadAdminNavPages.RedigeraBilderNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.RedigeraBilderNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.EditRecentlyUploadedImages"]"><i class="bi bi-pencil-square" aria-hidden="true"></i> @L["UploadAdmin.Navigation.EditImages"]</a>
        </li>
        <li>
            <a href="./UploadAdmin/FacebookUpload" class="nav-link @UploadAdminNavPages.FacebookUploadNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.FacebookUploadNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.ShareImagesOnFacebook"]"><i class="bi bi-facebook" aria-hidden="true"></i> @L["UploadAdmin.Navigation.ShareOnFacebook"]</a>
        </li>
        <li>
            <a href="./UploadAdmin/HanteraGB" class="nav-link @UploadAdminNavPages.HanteraGBNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.HanteraGBNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.ManageGuestbookEntries"]">
                <i class="bi bi-book-half" aria-hidden="true"></i> @L["UploadAdmin.Navigation.ManageGuestbookEntries"]
                @if (countOfUnreadGbPosts > 0)
                {
                    <span class="badge badge-success text-light">@L["Admin.Unread", countOfUnreadGbPosts]</span>
                }
            </a>
        </li>
        <li>
            <div class="dropdown-divider"></div>
            <a href="./UploadAdmin/Statistik" class="nav-link @UploadAdminNavPages.StatistikNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.StatistikNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.ViewSiteStatistics"]"><i class="bi bi-speedometer2" aria-hidden="true"></i> @L["UploadAdmin.Navigation.SiteStatistics"]</a>
        </li>
        <li><a href="./UploadAdmin/VisaLoggboken?datum=@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")" class="nav-link @UploadAdminNavPages.VisaLoggbokenNavClass(ViewContext)" aria-current="@(UploadAdminNavPages.VisaLoggbokenNavClass(ViewContext) is not null ? "page" : null)" title="@L["UploadAdmin.Navigation.ReadTheLogbookAndErrorLogs"]"><i class="bi bi-journal-code" aria-hidden="true"></i> @L["UploadAdmin.Navigation.ReadLogs"]</a></li>
        <li>
            <div class="dropdown-divider"></div>
            <a asp-area="Identity" asp-page="/Account/Manage/Index" title="@L["UploadAdmin.Navigation.ManageYourAccount"]" class="nav-link @UploadAdminNavPages.HanteraKontotNavClass(ViewContext)"><i class="bi bi-file-person"></i> @L["Admin.Account", username]</a>
        </li>
        <li><a asp-area="Identity" asp-page="/Account/Logout" class="nav-link @UploadAdminNavPages.LoggaUtNavClass(ViewContext)" title="@L["UploadAdmin.Navigation.LogOut"]"><i class="bi bi-lock"></i> @L["UploadAdmin.Navigation.LogOut"]</a></li>
    </ul>
}