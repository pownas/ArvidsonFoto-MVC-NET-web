@model ArvidsonFoto.Core.ViewModels.ErrorViewModel
@inject IStringLocalizer<SiteResource> S
@{
    ViewData["Title"] = Model?.VisitedUrl?.StartsWith("/images/gallery", StringComparison.OrdinalIgnoreCase) == true
        ? S["Error.Header.OldImage"].Value
        : Model?.VisitedUrl is null ? S["Error.Header.Title"].Value : S["Error.Header.NotFound"].Value;
}

<h2 class="mt-3 text-danger">@ViewData["Title"]</h2>
<h2 class="text-danger">@S["Error.Body.Message"]</h2>

@if (Model?.VisitedUrl is not null)
{
    <p class="text-break mb-0">
        <strong>@S["Error.Detail.RequestedUrl"]:</strong> <code><a href="/">ArvidsonFoto.se</a>@Model.VisitedUrl</code>
    </p>
}
<p class="text-break my-0">
    <strong>@S["Error.Detail.RequestTime"]:</strong> <code>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</code>
</p>
@if (Model!.ShowRequestId)
{
    <p class="text-break my-0">
        <strong>@S["Error.Detail.RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}
<p class="my-2">
    @S["Error.Body.Contact"] <a href="@LocalizedRoutes.Page("/Info/Kontakta")">@S["Error.Body.ContactLink"]</a>.
</p>
<p class="mt-4">
    @S["Error.Body.BackHome"]: <a href="/">ArvidsonFoto.se</a>.
</p>

@if (Model.VisitedUrl?.ToLower().StartsWith("/images/gallery") == true || Model.VisitedUrl?.ToLower().StartsWith(("/img/gallery")) == true)
{
    string url = Model.VisitedUrl;
    string[] splittedUrl = url.Split("/");
    string currentUrl = "https://arvidsonfoto.se/Bilder";
    foreach (var splitt in splittedUrl)
    {
        //Sökvägen ska inte innehålla: '/images/gallery/' eller '/images/gallery-thumb/' 
        if (splitt.Equals("images") is false && splitt.Equals("img") is false && splitt.Equals("gallery") is false && splitt.Equals("gallery-thumb") is false && string.IsNullOrWhiteSpace(splitt) is false)
            currentUrl += "/" + splitt;
    }

    <h3 class="mt-5 text-warning">@S["Error.OldImage.Title"]</h3>
    <p>@S["Error.OldImage.Message"]</p>
    <p>@S["Error.OldImage.Requested"]</p>
    <p>
        <figure class="figure alert alert-light" title="@S["Error.OldImage.Image"] 🖼">
            <img class="figure-img img-fluid rounded" src="@currentUrl" alt="@S["Error.OldImage.Image"]" />
            <figcaption class="figure-caption text-center text-truncate">@S["Error.OldImage.Image"]</figcaption>
        </figure>
    </p>
}
else
{
    <p class="mt-5 mb-0">@S["Error.Rabbit.Message"]</p>
    <p>
        <figure class="figure alert alert-light" title="@S["Error.Rabbit.Image"]">
            <img class="figure-img img-fluid rounded" src="https://arvidsonfoto.se/Bilder/D%C3%A4ggdjur/Kanin/B57V4570.thumb.jpg" alt="@S["Error.Rabbit.Image"]" />
            <figcaption class="figure-caption text-center text-truncate">@S["Error.Rabbit.Image"]</figcaption>
        </figure>
    </p>
}