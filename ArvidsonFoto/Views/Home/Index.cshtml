@using ArvidsonFoto.Core.Interfaces
@using ArvidsonFoto.Core
@using ArvidsonFoto.Core.Extensions
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@*<!-- Home-Index (Startsidan) -->*@
@model ArvidsonFoto.Core.ViewModels.GalleryViewModel

@section MetaData {
    <meta name="robots" content="noimageindex" />
    <meta name="description" content="@T["HomeMeta"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se/" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@T["HomeTitle"]">
    <meta name="twitter:description" content="@T["HomeMeta"]">
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg">

    <!-- Open Graph for social media sharing -->
    <meta property="og:title" content="@T["HomeTitle"]" />
    <meta property="og:description" content="@T["HomeMeta"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se/" />
}

<div id="page-header">
    <h2>Torbjörn Arvidson Foto <small>@T["Welcome"]</small></h2>
</div>

<div id="page-content" class="row">
    <div class="col-xs-12 col-sm-5">
        <p>@T["Intro"]</p>
        <p>
            @T["BuyIntro"] <br>
            @T["EmailIntro"] <a href="mailto:torbjorn_arvidson@hotmail.com">torbjorn_arvidson@hotmail.com</a>.
        </p>
        <p><i>/Torbjörn Arvidson</i></p>
        <div class="text-center text-md-left">
            <figure class="figure alert alert-light" title="Torbjörn Arvidson">
                <img class="figure-img img-fluid rounded" width="420" height="420" src="./img/Torbjorn2020.jpg" alt="Bild av: Torbjörn Arvidson" title="Torbjörn Arvidson" />
                <figcaption class="figure-caption text-center text-truncate">Torbjörn Arvidson</figcaption>
            </figure>
            <div class="text-center mt-2">
                <a href="@LocalizedRoutes.Page("/Info/Om_mig")" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-question-circle"></i> @T["ReadAbout"]
                </a>
            </div>
        </div>
    </div>
    <div id="page-gallery" class="mt-3 col-12 col-sm-7">
        <partial name="../Bilder/_GalleryStartpage" model="Model" />
        <div class="text-center">
            <small>@T["RandomPhotos"]</small>
        </div>
    </div><!-- /end-gallery -->
</div>

<!-- Promotional boxes (puffar) -->
<div class="row mt-5 mb-4">
    <div class="col-12">
        <h3 class="text-center mb-4">@T["Explore"]</h3>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <div class="card puff-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-camera puff-icon"></i>
                <h4 class="card-title mt-3">@T["LatestPhotos"]</h4>
                <p class="card-text">@T["LatestPhotosDetail"]</p>
                <a href="@LocalizedRoutes.Page("/Senast/Fotograferad")" class="btn btn-outline-primary">
                    <i class="bi bi-camera"></i> @T["ViewLatest"]
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <div class="card puff-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-grid-3x3-gap puff-icon"></i>
                <h4 class="card-title mt-3">@T["AllCategories"]</h4>
                <p class="card-text">@T["AllCategoriesDetail"]</p>
                <a href="@LocalizedRoutes.Page("/Senast/Per kategori")" class="btn btn-outline-primary">
                    <i class="bi bi-grid-3x3-gap"></i> @T["ViewCategories"]
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <div class="card puff-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-cart3 puff-icon"></i>
                <h4 class="card-title mt-3">@T["BuyPhotos"]</h4>
                <p class="card-text">@T["BuyPhotosDetail"]</p>
                <a href="@LocalizedRoutes.Page("/Info/Kop_av_bilder")" class="btn btn-outline-primary">
                    <i class="bi bi-cart3"></i> @T["ReadBuyPhotos"]
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mb-3">
        <div class="card puff-card h-100">
            <div class="card-body text-center">
                <i class="bi bi-diagram-3 puff-icon"></i>
                <h4 class="card-title mt-3">@T["Sitemap"]</h4>
                <p class="card-text">@T["SitemapDetail"]</p>
                <a href="@LocalizedRoutes.Page("/Info/Sidkarta")" class="btn btn-outline-primary">
                    <i class="bi bi-diagram-3"></i> @T["ViewSitemap"]
                </a>
            </div>
        </div>
    </div>
</div>