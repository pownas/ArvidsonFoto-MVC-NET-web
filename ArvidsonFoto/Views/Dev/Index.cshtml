@inject Microsoft.Extensions.Localization.IStringLocalizer<ArvidsonFoto.DevResource> L
@{
    ViewData["Title"] = L["Dev.Portal.DevelopmentAdminPortal"];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-4">
                    <i class="bi bi-tools"></i> ArvidsonFoto
                </h1>
                <h2>@L["Dev.Portal.DevelopmentAdminPortal"]</h2>
                <p class="text-muted">@L["Dev.Portal.QuickAccessToDevelopmentToolsAndAdminFeatures"]</p>
            </div>

            <!-- API Documentation Card -->
            <div class="card mb-4 shadow hover-shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-file-code"></i> @L["Dev.Portal.APIDocumentation"]
                    </h3>
                </div>
                <div class="card-body">
                    <p class="card-text">@L["Dev.Intro"]</p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <a href="/scalar/v1" class="btn btn-primary btn-lg" target="_blank">
                            <i class="bi bi-rocket-takeoff"></i> @L["Dev.Portal.OpenScalarAPIDocs"]
                        </a>
                        <a href="/openapi/v1.json" class="btn btn-outline-secondary" target="_blank">
                            <i class="bi bi-file-earmark-code"></i> @L["Dev.Portal.ViewOpenAPIJSON"]
                        </a>
                    </div>
                </div>
            </div>

            <!-- Admin Panel Card -->
            <div class="card mb-4 shadow hover-shadow-lg">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-shield-lock"></i> @L["Dev.Portal.AdminPanel"]
                    </h3>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        @L["Dev.Portal.ManageImagesCategoriesAndViewStatistics"]
                        <strong>@L["Dev.Portal.Note"]</strong> @L["Dev.Portal.AuthenticationRequired"]
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <a href="/UploadAdmin" class="btn btn-success btn-lg">
                            <i class="bi bi-gear"></i> @L["Dev.Portal.OpenAdminPanel"]
                        </a>
                        <a href="/UploadAdmin/RedigeraBilder" class="btn btn-outline-success">
                            <i class="bi bi-pencil-square"></i> @L["Dev.Portal.EditImages"]
                        </a>
                        <a href="/UploadAdmin/HanteraGB" class="btn btn-outline-success">
                            <i class="bi bi-book"></i> @L["Dev.Portal.ManageGuestbook"]
                        </a>
                    </div>
                </div>
            </div>

            <!-- Database & Tools Card -->
            <div class="card mb-4 shadow hover-shadow-lg">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-database"></i> @L["Dev.Portal.DevelopmentTools"]
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h5><i class="bi bi-check-circle"></i> @L["Dev.Portal.Environment"]</h5>
                            <ul class="list-unstyled">
                                <li>✅ @L["Dev.InMemoryDatabase"]</li>
                                <li>✅ @L["Dev.DevelopmentMode"]</li>
                                <li>✅ @L["Dev.ConsoleLogging"]</li>
                                <li>✅ @L["Dev.CorsEnabled"]</li>
                            </ul>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h5><i class="bi bi-link-45deg"></i> @L["Dev.Portal.QuickLinks"]</h5>
                            <ul class="list-unstyled">
                                <li><a href="/"><i class="bi bi-house"></i> @L["Dev.Portal.MainWebsite"]</a></li>
                                <li><a href="/Info/Sidkarta"><i class="bi bi-diagram-3"></i> @L["Dev.Portal.Sitemap"]</a></li>
                                <li><a href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right"></i> @L["Dev.Portal.Login"]</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aspire Dashboard Info -->
            <div class="alert alert-light border" role="alert">
                <h5 class="alert-heading"><i class="bi bi-info-circle"></i> @L["Dev.Portal.RunningViaNETAspire"]</h5>
                <p class="mb-0">@L["Dev.Aspire"]</p>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted">
                    <small>
                        <i class="bi bi-exclamation-triangle"></i> 
                        @L["Dev.Portal.ThisPageIsOnlyAccessibleInDevelopmentMode"]
                    </small>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow-lg:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
    }
    
    .card-header h3 {
        font-size: 1.5rem;
    }
    
    .btn-lg i {
        margin-right: 0.5rem;
    }
</style>
