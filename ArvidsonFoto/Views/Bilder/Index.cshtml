@inject IStringLocalizer<GalleryResource> G
@*<!-- Bilder-index (Galleriet) -->*@
@model GalleryViewModel
@inject IApiImageService _imageService
@inject IApiCategoryService _categoryService
@using ArvidsonFoto.Core.Interfaces
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@using System.Net

@section MetaData {
  <!-- Robots -->
  <meta name="robots" content="noimageindex, nofollow" />
  @{
    int pageImgCount = Model!.DisplayImagesList is not null ? Model.DisplayImagesList.Count : 0;
    int totalImgCount = Model.TotalImageCount > 0 ? Model.TotalImageCount : pageImgCount;
    string firstImageUrl = Model.DisplayImagesList?.FirstOrDefault()?.UrlImage ?? "";
    string fullImageUrl = !string.IsNullOrEmpty(firstImageUrl) ? $"https://ArvidsonFoto.se/{firstImageUrl}.jpg" : "";
  }
  <meta name="description" content="@G["Gallery.Metadata.Description", ViewData["Title"], totalImgCount]" />
  <link rel="canonical" href="@($"https://ArvidsonFoto.se{Model.CurrentUrl}")" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="@G["Gallery.Metadata.Title", ViewData["Title"]]">
  <meta name="twitter:description" content="@G["Gallery.Metadata.Description", ViewData["Title"], totalImgCount]">
  <meta name="twitter:image" content="@Html.Raw(fullImageUrl)">

  <!-- Open Graph for social media sharing -->
  <meta property="og:title" content="@G["Gallery.Metadata.Title", ViewData["Title"]]">
  <meta name="og:description" content="@G["Gallery.Metadata.Description", ViewData["Title"], totalImgCount]" />
  <meta property="og:image" content="@Html.Raw(fullImageUrl)">
  <meta property="og:url" content="@($"https://ArvidsonFoto.se{Model.CurrentUrl}")">
}

@{
  List<CategoryDto> subCategories = new List<CategoryDto>();
  List<CategoryDto> allCategories = new List<CategoryDto>();
  try
  {
    allCategories = _categoryService.GetAll();
    subCategories = _categoryService.GetSubsList(Model!.SelectedCategory.CategoryId ?? 0)
                                    .OrderBy(c => LocalizedText.Select(c.NameSv, c.NameEn))
                                    .ToList();

    if (Model.SelectedCategory is not null && !string.IsNullOrEmpty(Model.SelectedCategory.NameSv))
    {
      ViewData["Title"] = LocalizedText.Select(Model.SelectedCategory.NameSv, Model.SelectedCategory.NameEn);
    }
    else
    {
      ViewData["Title"] = "Ingen kategori skickades med...";
    }
  }
  catch (Exception ex)
  {
    Model!.ErrorMessage = ex.Message;
    ViewData["Title"] = "Bilder-sidan hittades inte";
  }

  // Helper function to get popover attributes for a category
  string GetPopoverAttributes(CategoryDto category)
  {
    var image = _imageService.GetOneImageFromCategory(category.CategoryId ?? 0);
    if (image == null || string.IsNullOrWhiteSpace(image.UrlImage))
    {
      return "";
    }

    string imageUrl = $"/{image.UrlImage}.thumb.jpg";

    // Build the popover content - escape the values but not the HTML structure
    string escapedCategoryName = WebUtility.HtmlEncode(LocalizedText.Select(category.NameSv, category.NameEn)) ?? string.Empty;
    string escapedImageUrl = WebUtility.HtmlEncode(imageUrl) ?? string.Empty;
    string popoverContent = $"<div class='category-tooltip'><img src='{escapedImageUrl}' alt='{escapedCategoryName}' class='img-fluid' /><div class='category-name'>{escapedCategoryName}</div></div>";

    return $"data-toggle=\"popover\" data-trigger=\"hover\" data-html=\"true\" data-content=\"{WebUtility.HtmlEncode(popoverContent)}\" data-placement=\"right\"";
  }
}
<nav id="page-breadcrumbs" aria-label="breadcrumb">
  <ol class="breadcrumb bg-dark-arvidsonfoto">
    <li class="breadcrumb-item"><a href="/">ArvidsonFoto.se</a></li>
    @{
      string[] splittUrl = Model.CurrentUrl.Split('/', StringSplitOptions.RemoveEmptyEntries);
      string currentUrl = "";
      var breadcrumbSegments = new List<string>();
      for (int i = 0; i < splittUrl.Length; i++)
      {
        currentUrl += "/" + splittUrl[i];
        if (i > 0)
        {
          breadcrumbSegments.Add(splittUrl[i]);
        }
        var breadcrumbCategory = i == 0 ? null : ArvidsonFoto.Core.Extensions.LocalizedRoutes.ResolveCategoryPath(breadcrumbSegments, allCategories);
        var label = i == 0 ? T["Navigation.Photos"].Value :
          breadcrumbCategory is not null ? LocalizedText.Select(breadcrumbCategory.NameSv, breadcrumbCategory.NameEn) : splittUrl[i];
        if (i == splittUrl.Length - 1)
        {
          <li class="breadcrumb-item active" aria-current="page">@label</li>
        }
        else
        {
          <li class="breadcrumb-item"><a href="@currentUrl">@label</a></li>
        }
      }
    }
  </ol>
</nav>

@if (Model.SelectedCategory is not null)
{
  <h2 id="CategoryId-@Model.SelectedCategory.CategoryId">@ViewData["Title"]</h2>
}
else
{
  <h2>@ViewData["Title"]</h2>

  @if(ViewData["Title"]!.Equals("Bilder-sidan hittades inte"))
  {
    Log.Fatal("Could not show the Image-URL: '" + currentUrl + "'");
  }
}

@if (subCategories is not null)
{
  <div class="categories">
  @foreach (var category in subCategories)
  {
    string segment = ArvidsonFoto.Core.Extensions.LocalizedRoutes.CategorySegment(category);
    string popoverAttrs = GetPopoverAttributes(category);
    <a id="MenuId-@category.CategoryId" class="my-1 p-1 btn btn-light btn-outline-primary text-dark" href="@(Model.CurrentUrl + "/" + segment)" @Html.Raw(popoverAttrs)>@LocalizedText.Select(category.NameSv, category.NameEn)</a>
  }
  </div>
}


@if (Model.TotalPages > 1)
{
  <partial name="_PageCounter" model="Model" view-data="@(new ViewDataDictionary(ViewData) { { "suffix", "-top" } })" />
}
else
{
  if (Model.TotalImageCount > 12)
  {
    <p id="page-image-counter-top" class="text-center">@G["Gallery.Counter.Images", Model.TotalImageCount, Model.CurrentPage, Model.TotalPages]</p>
  }
}

<partial name="_Gallery" model="Model" />

@if (Model.TotalPages > 1)
{
  <partial name="_PageCounter" model="Model" view-data="@(new ViewDataDictionary(ViewData) { { "suffix", "-bottom" } })" />
}
else
{
  if (Model.TotalImageCount > 0)
  {
    <p id="page-image-counter-bottom" class="text-center">@G["Gallery.Counter.Images", Model.TotalImageCount, Model.CurrentPage, Model.TotalPages]</p>
  }
}