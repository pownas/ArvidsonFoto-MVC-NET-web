@inject IStringLocalizer<GalleryResource> G
@model GalleryViewModel
@inject IApiImageService _imageService
@using ArvidsonFoto.Core.Interfaces
@using ArvidsonFoto.Core.DTOs
@using ArvidsonFoto.Core
@using ArvidsonFoto.Core.Extensions
@inject IApiCategoryService CategoryService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@using System.Net
@{
  string bilderBase = LocalizedRoutes.Gallery;
  var categories = CategoryService.GetAll();
  List<ImageDto> imageList = Model!.DisplayImagesList;

  int imageCount = 0;
  if (imageList is not null)
      imageCount = imageList.Count();

  // Räkna ut global offset för sidnumrering (sida 2 = offset 48, sida 3 = offset 96 osv.)
  int pageOffset = Math.Max(0, Model.CurrentPage - 1) * Math.Max(1, Model.PageSize);
  int totalCount = Model.TotalImageCount > 0 ? Model.TotalImageCount : imageCount;

  //Kontroll om det är startsidan eller ej...
  bool startsidan = false;
  if (imageCount.Equals(12) && Model!.SelectedCategory is null || Model!.SelectedCategory is null)
      startsidan = true;

  //Om modellen är exakt 12 (som på startsidan) , så kommer det att justeras i bredd för startsidans, annars : justeras det för bredare galleri.
  string rowSizeClass = startsidan ? "col-4 col-lg-3" : "col-4 col-sm-3 col-lg-2";
  //bredden innan texten bryts på tumnaglarna (olika på startsidan/övriga):
  string imgCharWidth = startsidan ? "thumb-img-startpage" : "thumb-img-gallery";
  string figcaptionCharWidth = startsidan ? "thumb-figcaption-startpage" : "thumb-figcaption-gallery";
}

@if (imageList is null || imageList.Count.Equals(0))
{
  if (Model.SelectedCategory?.NameSv == "Fåglar")
  {
    <p class="m-4">@G["Gallery.Empty.ChooseBirdCategory"] ⤴</p>
  }
  else
  {
    <p>
      @G["Gallery.Empty.Message"] <br />
      @G["Gallery.Empty.SeeAllPhotos"] <a href="@LocalizedRoutes.Page("/Senast/Fotograferad")">ArvidsonFoto.se@LocalizedRoutes.Page("/Senast/Fotograferad")</a>.
    </p>
    <p class="mt-4">
      @G["Gallery.Empty.RabbitInstead"] 🐇
    </p>
    <div id="imageRabbit" class="col-12 col-sm-10 col-md-8 col-lg-6">
      <figure class="figure alert alert-light" title="@G["Gallery.Empty.Rabbit"] 🐇">
        <img class="figure-img img-fluid rounded" src="https://arvidsonfoto.se/Bilder/D%C3%A4ggdjur/Kanin/B57V4570.jpg" alt="@G["Gallery.Empty.Rabbit"]" />
        <figcaption class="figure-caption text-center text-truncate">@G["Gallery.Empty.Rabbit"] 🐇</figcaption>
      </figure>
    </div>
    <h3>@G["Gallery.Empty.SearchCategories"]</h3>
    <div id="search" class="mb-5">
      @G["Gallery.Empty.SearchOrSitemap"]
      <a href="@LocalizedRoutes.Page("/Info/Sidkarta")">@T["Navigation.Sitemap"] <i class="bi bi-diagram-3"></i></a><br />
      <partial name="../Bilder/_SearchBar" />
    </div>
  }
}
else
{
  <div id="gallery" class="row"
       data-current-page="@Model.CurrentPage"
       data-total-pages="@Model.TotalPages"
       data-page-size="@Model.PageSize"
       data-total-images="@Model.TotalImageCount"
       data-gallery-url="@Model.CurrentUrl">
    @{ var index = 1; }
    @foreach (var img in imageList)
    {
      string customDesc = "custom-desc" + index;

      string imgHref = img.CategoryId > 0
          ? LocalizedRoutes.CategoryForId(img.CategoryId, categories)
          : img.UrlCategory ?? bilderBase;
      // Extract category name from URL if Name is empty or default value
      // In search scenario, prefer CategoryName over Name (which might be the filename)
      string imgTitle = !string.IsNullOrWhiteSpace(img.CategoryName)
          ? img.CategoryName
          : (!string.IsNullOrWhiteSpace(img.Name) && !img.Name.Equals("Bild") && !img.Name.Equals("404-NotFound")
              ? img.Name
              : (!string.IsNullOrWhiteSpace(img.UrlImage) ? img.UrlImage.Split('/').Last() : "Bild"));
      string imgDesc = "";

      if (String.IsNullOrWhiteSpace(img.Description) is false)
          imgDesc = ", " + img.Description + ".";

      // UrlImage already contains the full path (e.g., "bilder/kategori/subcategory/filename")
      // Just add the domain prefix for thumb and full image
      string imgThumbSrc = $"https://arvidsonfoto.se/{img.UrlImage}.thumb.jpg";
      string imgSrc = $"https://arvidsonfoto.se/{img.UrlImage}.jpg";
      string imgName = img.UrlImage.Split('/').Last() + ".jpg";

      DateTime imgDate = img.DateImageTaken ?? new DateTime(1900, 01, 01);
      string imgDateDisplay = imgDate.Year == 1900 ? G["Gallery.Image.Missing"].Value : imgDate.ToString("yyyy-MM-dd");

      if (Model.SelectedCategory is not null && Model.SelectedCategory.UrlCategoryPath is not null && Model.SelectedCategory.UrlCategoryPath.Equals("/Search"))
      {
        <figure id="ImgId-@img.ImageId" class="figure @rowSizeClass p-2">
          <a href="@imgHref" rel="nofollow" class="rounded btn btn-light thumb-a-class" title="@G["Gallery.Image.ViewAllOf", imgTitle]@imgDesc">
            <img src="@imgThumbSrc" alt="@imgTitle@imgDesc" class="figure-img img-fluid rounded @imgCharWidth" width="120" height="120" title="@G["Gallery.Image.ViewAllOf", imgTitle]@imgDesc">
            <figcaption class="figure-caption d-block text-truncate @figcaptionCharWidth">@imgTitle</figcaption>
          </a>
        </figure>
      }
      else
      {
        <figure id="ImgId-@img.ImageId" class="figure @rowSizeClass p-2">
          <a href="@imgSrc" rel="nofollow" class="glightbox rounded btn btn-light thumb-a-class" data-gallery="gallery1" data-glightbox="title: @imgTitle; description: .@customDesc" title="@imgTitle@imgDesc
@G["Gallery.Image.Enlarge"]">
            <img src="@imgThumbSrc" alt="@imgTitle@imgDesc" class="figure-img img-fluid rounded @imgCharWidth" width="120" height="120" title="@imgTitle@imgDesc
@G["Gallery.Image.Enlarge"]">
            <figcaption class="figure-caption d-block text-truncate @figcaptionCharWidth">@imgTitle</figcaption>
          </a>
        </figure>

        <div class="glightbox-desc row @customDesc">
          <p>@G["Gallery.Image.Position", pageOffset + index, totalCount] - <a href="@imgHref" title="@G["Gallery.Image.ViewAllOf", imgTitle]@imgDesc">@imgTitle</a>@imgDesc @G["Gallery.Image.Date"]: @imgDateDisplay</p>
          <p>@G["Gallery.Image.FileName"]: @imgName <a rel="nofollow" href="@LocalizedRoutes.Page("/Info/Copyright")">© Torbjörn Arvidson</a>. @G["Gallery.Image.BuyPrompt"] <a rel="nofollow" href="@(LocalizedRoutes.Page("/Info/Kop_av_bilder"))?imgId=@img.ImageId">@T["Navigation.BuyPhotos"]</a></p>
        </div>
      }

      index += 1;
    }
  </div><!-- /end-gallery-row -->
}
