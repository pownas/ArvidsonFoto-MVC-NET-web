@inject IStringLocalizer<GalleryResource> G
@model GalleryViewModel
@using ArvidsonFoto.Core
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@{
    string idSuffix = ViewData["suffix"] as string ?? "";
}

@if (Model!.TotalImageCount > 0)
{
  <p class="text-center">
      @(Model.SelectedCategory?.NameSv == "Per kategori"
        ? G["Gallery.Counter.Categories", Model.TotalImageCount, Model.CurrentPage, Model.TotalPages]
        : G["Gallery.Counter.Images", Model.TotalImageCount, Model.CurrentPage, Model.TotalPages])
  </p>
}

@if (Model.TotalPages > 1) // === Page-counter (Sidräknaren) ===
{
  <nav id="page-counter@(idSuffix)" aria-label="@G["Gallery.Pagination.Label"]">
    <ul class="pagination justify-content-center">
    @if (Model.CurrentPage > 1)
    {
      <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)">@G["Gallery.Pagination.First"]</a></li>
      <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.CurrentPage - 1)" aria-label="@G["Gallery.Pagination.Previous"]"><span aria-hidden="true">« @(Model.CurrentPage - 1)</span></a></li>
    }
    else
    {
      <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">@G["Gallery.Pagination.First"]</a></li>
      <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">«</a></li>
    }
      <li class="page-item active"><a class="page-link" aria-label="@G["Gallery.Pagination.Current"]">@(Model.CurrentPage)<span class="sr-only"> (@G["Gallery.Pagination.Current"])</span></a></li>
    @if (Model.CurrentPage == Model.TotalPages)
    {
      <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true"> »</a></li>
      <li class="page-item disabled"><a class="page-link" tabindex="-1" aria-disabled="true">@G["Gallery.Pagination.Last"]</a></li>
    }
    else
    {
      <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.CurrentPage + 1)" aria-label="@G["Gallery.Pagination.Next"]">@(Model.CurrentPage + 1) »</a></li>
      <li class="page-item"><a class="page-link" href="@(Model.CurrentUrl)?sida=@(Model.TotalPages)">@G["Gallery.Pagination.Last"]</a></li>
    }
    </ul>
  </nav>
}@*// === Slutet på page-counter (Paging, sidnumreringen) ===*@