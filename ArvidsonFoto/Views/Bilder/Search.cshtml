@model GalleryViewModel
@using ArvidsonFoto.Core
@using ArvidsonFoto.Core.Extensions
@inject ArvidsonFoto.Core.Interfaces.IApiCategoryService CategoryService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> T
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(ViewBag.SearchQuery)
        ? T["SearchCategories"].Value
        : $"{T["SearchingFor"].Value} {ViewBag.SearchQuery}";
}
@section MetaData {
    <meta name="robots" content="noimageindex, nofollow" />
    <meta name="description" content="@T["SearchMeta"]" />
    <link rel="canonical" href="https://ArvidsonFoto.se/Search" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@T["SearchTitle"]">
    <meta name="twitter:description" content="@T["SearchMeta"]">
    <meta name="twitter:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg">

    <!-- Open Graph for social media sharing -->
    <meta property="og:title" content="@T["SearchTitle"]" />
    <meta property="og:description" content="@T["SearchMeta"]" />
    <meta property="og:image" content="https://ArvidsonFoto.se/img/Torbjorn2020.jpg" />
    <meta property="og:url" content="https://ArvidsonFoto.se/Search" />
}

<nav id="page-breadcrumbs" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark-arvidsonfoto">
        <li class="breadcrumb-item"><a rel="nofollow" href="/">ArvidsonFoto.se</a></li>
        <li class="breadcrumb-item active" aria-current="page">@T["Search"]<i class="bi bi-search mx-1"></i></li>
    </ol>
</nav>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery))
            {
                <h1 class="mb-4">
                    <i class="bi bi-search"></i> @T["SearchingFor"] <span class="text-primary">"@ViewBag.SearchQuery"</span>
                </h1>
            }
            else
            {
                <h1 class="mb-4">
                    <i class="bi bi-search"></i> @T["SearchCategories"]
                </h1>
            }

            <!-- Search bar in a card -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <partial name="_SearchBar" />
                    <small class="form-text text-muted d-block mt-2">
                        <i class="bi bi-info-circle"></i> @T["SearchHint"]
                    </small>
                </div>
            </div>

            @if (Model?.DisplayImagesList is not null && Model.DisplayImagesList.Count > 0)
            {
                <!-- Search results header -->
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>
                        <strong>@T["SearchSuccess"]</strong> @(Model.DisplayImagesList.Count == 1
                            ? T["FoundCategory", Model.DisplayImagesList.Count]
                            : T["FoundCategories", Model.DisplayImagesList.Count])
                    </div>
                </div>
            }
            else if ((ViewBag.SearchPerformed ?? false) && Model?.DisplayImagesList is not null && Model?.DisplayImagesList.Count == 0)
            {
                <!-- No results found - only show when a search was actually performed -->
                <div class="alert alert-warning d-flex align-items-start" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>
                        <h4 class="alert-heading">@T["NoResults"]</h4>
                        <p class="mb-2">@T["NoSearchMatches", ViewBag.SearchQuery]</p>
                        <hr>
                        <p class="mb-0">
                            <i class="bi bi-lightbulb"></i> <strong>@T["Tip"]</strong> @T["TrySearchingFor"]
                        </p>
                        <ul class="mb-2">
                            <li>@T["SearchExampleAnimal"]</li>
                            <li>@T["SearchExampleCategory"]</li>
                            <li>@T["SearchExampleGeneral"]</li>
                        </ul>
                        <p class="mb-0">
                            @T["SearchBug"]
                            <a href="@LocalizedRoutes.Page("/Info/Kontakta")" class="alert-link">@T["ContactMe"]</a>.
                        </p>
                    </div>
                </div>

                <!-- Alternative navigation -->
                <div class="row mt-4">
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="bi bi-diagram-3 fs-1 text-primary mb-3"></i>
                                <h5 class="card-title">@T["Sitemap"]</h5>
                                <p class="card-text">@T["ViewAvailableCategories"]</p>
                                <a href="@LocalizedRoutes.Page("/Info/Sidkarta")" class="btn btn-outline-primary">
                                    <i class="bi bi-diagram-3"></i> @T["GoToSitemap"]
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center">
                                <i class="bi bi-calendar-week fs-1 text-success mb-3"></i>
                                <h5 class="card-title">@T["LatestPhotos"]</h5>
                                <p class="card-text">@T["SeeNewestPhotos"]</p>
                                <a href="@LocalizedRoutes.Page("/Senast/Uppladdad")" class="btn btn-outline-success">
                                    <i class="bi bi-camera"></i> @T["RecentlyUploaded"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Initial state - no search performed -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-info-circle text-info"></i> @T["HowToSearch"]
                                </h5>
                                <p class="card-text">@T["SearchInstructions"]</p>
                                <p class="mb-0"><strong>@T["ExampleKeywords"]</strong></p>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <a href="@LocalizedRoutes.Search?s=@Uri.EscapeDataString(T["ExampleButterfly"].Value)" class="badge bg-secondary text-decoration-none">@T["ExampleButterfly"]</a>
                                    <a href="@LocalizedRoutes.Search?s=@Uri.EscapeDataString(T["ExampleEagle"].Value)" class="badge bg-secondary text-decoration-none">@T["ExampleEagle"]</a>
                                    <a href="@LocalizedRoutes.Search?s=@Uri.EscapeDataString(T["ExampleFox"].Value)" class="badge bg-secondary text-decoration-none">@T["ExampleFox"]</a>
                                    <a href="@LocalizedRoutes.Search?s=@Uri.EscapeDataString(T["ExampleLandscape"].Value)" class="badge bg-secondary text-decoration-none">@T["ExampleLandscape"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-lightning text-warning"></i> @T["QuickLinks"]
                                </h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <a href="@LocalizedRoutes.Page("/Info/Sidkarta")" class="text-decoration-none">
                                            <i class="bi bi-diagram-3 text-primary"></i> @T["SeeCategoriesInSitemap"]
                                        </a>
                                    </li>
                                    <li class="mb-2">
                                        <a href="@LocalizedRoutes.Page("/Senast/Per kategori")" class="text-decoration-none">
                                            <i class="bi bi-grid-3x3-gap text-success"></i> @T["RecentByCategory"]
                                        </a>
                                    </li>
                                    <li class="mb-2">
                                        <a href="@LocalizedRoutes.CategoryForId(1, CategoryService.GetAll())" class="text-decoration-none">
                                            <i class="bi bi-camera text-info"></i> @T["BrowseBirdPhotos"]
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model?.DisplayImagesList is not null && Model.DisplayImagesList.Count > 0)
{
    <!-- Gallery - full width outside constrained container -->
    <div class="container-fluid px-3">
        <partial name="_Gallery" model="Model" />
    </div>

    <!-- Results footer with clear heading -->
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="card shadow-sm mt-4 mb-4">
                    <div class="card-body text-center">
                        <h3 class="mb-3">
                            <i class="bi bi-check-circle text-success"></i> @T["SearchResults"]
                        </h3>
                        <p class="text-muted mb-2">
                            @T["YourSearchFor"] <strong class="text-primary">"@ViewBag.SearchQuery"</strong> @T["Returned"]
                        </p>
                        <p class="fs-4 mb-0">
                            <i class="bi bi-images"></i> @(Model.DisplayImagesList.Count == 1
                                ? T["FoundCategory", Model.DisplayImagesList.Count]
                                : T["FoundCategories", Model.DisplayImagesList.Count])
                        </p>
                        <hr class="my-3">
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="@LocalizedRoutes.Search" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-clockwise"></i> @T["NewSearch"]
                            </a>
                            <a href="@LocalizedRoutes.Page("/Info/Sidkarta")" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-diagram-3"></i> @T["ViewCategories"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}